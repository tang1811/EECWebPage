@page "/publish"
@rendermode InteractiveServer
@inject PublishService Publisher
@inject IJSRuntime JS

<PageTitle>เผยแพร่เว็บไซต์ · EEC Admin</PageTitle>

<h1>เผยแพร่เว็บไซต์</h1>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-outline-primary" disabled="@running" @onclick="DoPreviewAsync">
        @(running && mode == "preview" ? "กำลังสร้างตัวอย่าง..." : "ดูตัวอย่าง (preview)")
    </button>
    <button class="btn btn-danger" disabled="@running" @onclick="DoPublishAsync">
        @(running && mode == "publish" ? "กำลังเผยแพร่..." : "เผยแพร่ขึ้นเว็บจริง")
    </button>
</div>

@if (previewReady)
{
    <div class="alert alert-info">
        เปิดดูตัวอย่างได้ที่ <a href="http://localhost:5081/" target="_blank">http://localhost:5081/</a>
        (รวมข่าวฉบับร่าง)
    </div>
}

@if (result is not null)
{
    <div class="alert @(result.Success ? "alert-success" : "alert-danger")">
        @(result.Success ? "สำเร็จ" : "ไม่สำเร็จ — ตรวจสอบ log ด้านล่าง")
    </div>
    <pre class="border rounded bg-light p-3" style="white-space: pre-wrap; max-height: 30rem; overflow-y: auto;">@result.Log</pre>
}

@code {
    private bool running;
    private string mode = "";
    private bool previewReady;
    private PipelineResult? result;

    private async Task DoPreviewAsync()
    {
        running = true;
        mode = "preview";
        result = null;
        previewReady = false;
        StateHasChanged();

        result = await Publisher.PreviewAsync();
        previewReady = result.Success;
        running = false;
    }

    private async Task DoPublishAsync()
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            "ยืนยันเผยแพร่ขึ้นเว็บจริง? ข้อมูลจะถูกคัดลอกไปยังเซิร์ฟเวอร์เว็บไซต์ทันที");
        if (!ok) return;

        running = true;
        mode = "publish";
        result = null;
        previewReady = false;
        StateHasChanged();

        result = await Publisher.PublishLiveAsync();
        running = false;
    }
}
