---
import {
  SITE_URL,
  SITE_NAME,
  DEFAULT_TITLE,
  DEFAULT_DESCRIPTION,
  DEFAULT_KEYWORDS,
  DEFAULT_OG,
  ORG_JSONLD,
  GA_ID,
} from '../config';
import { createHash } from 'node:crypto';
// ?raw hands us the file's text at build time. Reading it with fs instead would
// resolve against the emitted chunk in dist/, not the source tree — that fails.
import mobileCssSource from '../../public/styles/mobile.css?raw';
import '../styles/globals.css';
import '../styles/styles.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';

interface OgOverride {
  title: string;
  description: string;
  image: string; // root-absolute path, e.g. '/assets/courses/yon.webp'
  type?: 'article' | 'website'; // news/article pages; course pages omit (matches old Next output)
}

interface Props {
  title?: string; // short title, templated to `${title} · ${SITE_NAME}`; omit on homepage
  description?: string;
  path: string; // canonical path WITHOUT trailing slash ('' for homepage)
  keywords?: string[];
  og?: OgOverride; // when absent the root-layout OG defaults are emitted (og:url = '/')
  chrome?: boolean; // false on /admission routes: no Nav/Footer/StickyCTA (parity with old site)
  mono600?: boolean; // /about and /video load an extra JetBrains Mono stylesheet with weight 600
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  path,
  // Next.js inherits the root layout's keywords on pages that don't set their
  // own (verified against the live site) — replicate that inheritance here.
  keywords = DEFAULT_KEYWORDS,
  og,
  chrome = true,
  mono600 = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : DEFAULT_TITLE;
// Live Next site emits canonical/og:url WITH trailing slash (trailingSlash: true).
const canonical = `${SITE_URL}${path}/`;
const ogTitle = og?.title ?? DEFAULT_OG.title;
const ogDescription = og?.description ?? DEFAULT_OG.description;
const ogUrl = og ? canonical : `${SITE_URL}/`;
const ogImage = `${SITE_URL}${og?.image ?? '/assets/logo.png'}`;
const ogType = og ? og.type : 'website';
// Preview builds (PUBLIC_PREVIEW=1): noindex + visible draft ribbon.
const isPreview = Boolean(import.meta.env.PUBLIC_PREVIEW);

// mobile.css says of itself "loaded LAST so it wins over page CSS", and Astro
// cannot deliver that: a layout's imports are bundled ahead of the page's, so
// <link Base.css> came out before <link homepage.css> and every phone rule
// without !important lost a same-specificity tie — .stat-v stayed 52px instead
// of 30px, .stats-bar 60px instead of 36px, and so on. Serving it from public/
// and linking it after <slot name="head" /> makes it genuinely last.
// public/ is copied verbatim and never fingerprinted, so hash the bytes into
// the URL — otherwise browsers keep a stale copy after every edit.
const mobileCssHref = `/styles/mobile.css?v=${createHash('sha256')
  .update(mobileCssSource)
  .digest('hex')
  .slice(0, 8)}`;
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/logo.png" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:image" content={ogImage} />
    {ogType && <meta property="og:type" content={ogType} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    {
      mono600 && (
        <link
          href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
          rel="stylesheet"
        />
      )
    }
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ORG_JSONLD)} />
    {GA_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    {
      GA_ID && (
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <!-- Deliberately in <body>, not <head>: Astro appends its bundled <link>s to
         the end of <head>, so anything placed there — even after the head slot —
         still comes out ahead of them. First child of <body> is the earliest
         position that is guaranteed to follow every bundle. The preload scanner
         picks it up in the same pass as the head, so this does not cost a
         round-trip or flash an unstyled layout. -->
    <link rel="stylesheet" href={mobileCssHref} />
    {
      isPreview && (
        <div style="position:fixed;left:12px;bottom:12px;z-index:9999;background:#b45309;color:#fff;padding:6px 14px;border-radius:999px;font-size:12px;font-weight:700;box-shadow:0 4px 14px rgba(0,0,0,.3)">
          PREVIEW — ฉบับร่าง ยังไม่เผยแพร่
        </div>
      )
    }
    {chrome && <Nav />}
    <slot />
    {chrome && <Footer />}
    {chrome && <StickyCTA />}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
