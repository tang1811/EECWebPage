  line: '<path d="M12 2C6.5 2 2 5.6 2 10c0 3.9 3.6 7.2 8.4 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.8c0 .3-.2 1 .9.5s5.7-3.4 7.8-5.8c1.5-1.6 2.1-3.3 2.1-4.9C22 5.6 17.5 2 12 2z" fill="currentColor"/>',
};

