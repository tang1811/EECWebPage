---
// Floating contact FAB (speed-dial) — 1:1 port of StickyCTA() from
// web/app/components/chrome.tsx. React only mounted .bubble-stack,
// .bubble-teaser and the trigger close-icon while their state was on;
// here they render inline hidden (display:none) and src/scripts/site.ts
// toggles them (open/close, Escape, 6s teaser timer, aria sync).
// Base.astro omits this component on /admission routes.
type FabAction = {
  href: string;
  label: string;
  sub: string;
  icon: string;
  color: string;
  external?: boolean;
  primary?: boolean;
};

const actions: FabAction[] = [
  { href: 'tel:038494066', label: 'โทร 038-494-066', sub: 'ฝ่ายธุรการ', icon: 'phone', color: 'green' },
  { href: 'https://www.facebook.com/eec.engineer.laemchabang', label: 'Messenger', sub: 'ตอบไว · 24 ชม.', icon: 'facebook', color: 'fb', external: true },
  { href: '#', label: 'Line @eec-lc', sub: 'Official Account', icon: 'line', color: 'line' },
  { href: 'mailto:technologylaemchabang@gmail.com', label: 'อีเมล', sub: 'ส่งข้อความ', icon: 'mail', color: 'mail' },
  { href: '/admission/', label: 'สมัครเรียน 2569', sub: 'ฟอร์ม 5 นาที · กดเลย', icon: 'sparkle', color: 'green', primary: true },
];

// Verbatim chrome.tsx Icon paths (JSX camelCase attrs → kebab-case HTML).
const ICONS: Record<string, string> = {
  phone: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  facebook: '<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" fill="currentColor"/>',
  line: '<path d="M12 2C6.5 2 2 5.6 2 10c0 3.9 3.6 7.2 8.4 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.8c0 .3-.2 1 .9.5s5.7-3.4 7.8-5.8c1.5-1.6 2.1-3.3 2.1-4.9C22 5.6 17.5 2 12 2z" fill="currentColor"/>',
  mail: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 4l8 5 8-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  sparkle: '<path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2zM18 4l.9 2.1L21 7l-2.1.9L18 10l-.9-2.1L15 7l2.1-.9L18 4z" fill="currentColor"/>',
  close: '<path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
};
---

<div class="sticky-bubble ">
  <div class="bubble-stack" role="menu" style="display:none">
    {actions.map((a, i) => (
      <a
        href={a.href}
        {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}
        class={`bubble-fab fab-${a.color} ${a.primary ? 'primary' : ''}`}
        style={`--i:${i}`}
        role="menuitem"
      >
        <span class="fab-label">
          <strong>{a.label}</strong>
          <em>{a.sub}</em>
        </span>
        <span class="fab-icon">
          <svg viewBox="0 0 24 24" class="" style="width:22px;height:22px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS[a.icon]} />
        </span>
      </a>
    ))}
  </div>

  <div class="bubble-teaser" style="display:none">
    <span>เปิดรับสมัครแล้ว! ปรึกษาเราได้ทันที</span>
    <button class="bubble-teaser-x" aria-label="ปิด"><svg viewBox="0 0 24 24" class="" style="width:12px;height:12px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.close} /></button>
  </div>

  <button class="bubble-trigger" aria-label="เปิดเมนูติดต่อ" aria-expanded="false">
    <span class="bubble-rings" aria-hidden="true">
      <span class="ring"></span>
      <span class="ring"></span>
    </span>
    <svg viewBox="0 0 24 24" class="" style="width:24px;height:24px;position:relative;z-index:2;display:none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.close} />
    <svg viewBox="0 0 24 24" class="bubble-chat-icon" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" fill="white" stroke="white" stroke-width="1.5" stroke-linejoin="round"></path>
      <circle cx="8.5" cy="11.5" r="1.2" fill="var(--green-700)"></circle>
      <circle cx="12" cy="11.5" r="1.2" fill="var(--green-700)"></circle>
      <circle cx="15.5" cy="11.5" r="1.2" fill="var(--green-700)"></circle>
    </svg>
    <span class="bubble-online-dot" aria-hidden="true"></span>
  </button>
</div>
