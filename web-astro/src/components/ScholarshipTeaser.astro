---
interface Props {
  title: string;
  href: string;
  image?: string;
  linkedCard?: boolean;
}
const { title, href, image, linkedCard = false } = Astro.props;
const Card = linkedCard ? 'a' : 'article';
---

<Card
  class:list={['scholarship-teaser', { 'scholarship-teaser-link': linkedCard }]}
  href={linkedCard ? href : undefined}
  aria-label={linkedCard ? `${title} — ดูรายละเอียดและเงื่อนไข` : undefined}
>
  <div class="scholarship-teaser-image">
    {image && <img src={image} alt={title} loading="lazy" />}
  </div>
  <div class="scholarship-teaser-body">
    <h3>{title}</h3>
    {linkedCard ? (
      <span class="scholarship-teaser-action">
        <span>ดูรายละเอียดและเงื่อนไข</span>
        <span class="scholarship-teaser-arrow" aria-hidden="true">→</span>
      </span>
    ) : (
      <a class="scholarship-teaser-button" href={href} aria-label={`ดูรายละเอียด ${title}`}>ดูรายละเอียด <span aria-hidden="true">→</span></a>
    )}
  </div>
</Card>

<style>
  .scholarship-teaser { height: 100%; min-width: 0; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e0e7e1; border-radius: 16px; background: #fff; }
  .scholarship-teaser-link { color: inherit; text-decoration: none; transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
  .scholarship-teaser-link:is(:hover, :focus-visible) { border-color: #0c6149; box-shadow: 0 12px 28px -16px rgba(6, 77, 61, .35); }
  .scholarship-teaser-link:focus-visible { outline: 3px solid #b18728; outline-offset: 4px; }
  .scholarship-teaser-image { position: relative; aspect-ratio: 4 / 3; flex-shrink: 0; overflow: hidden; background: #f1f4ef; }
  .scholarship-teaser-image img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  .scholarship-teaser-body { padding: 22px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; flex: 1; }
  h3 { margin: 0; font-size: clamp(19px, 2.2vw, 24px); line-height: 1.5; color: #142b24; }
  .scholarship-teaser-action { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 16px; margin-top: auto; padding-top: 16px; border-top: 1px solid #e0e7e1; color: #07533e; font-size: 14px; font-weight: 700; }
  .scholarship-teaser-arrow { display: grid; place-items: center; width: 40px; height: 40px; flex-shrink: 0; border: 1px solid #d4e4d9; border-radius: 50%; background: #edf5ef; font-size: 20px; transition: background .2s ease, color .2s ease, border-color .2s ease; }
  .scholarship-teaser-link:is(:hover, :focus-visible) .scholarship-teaser-arrow { background: #064d3d; border-color: #064d3d; color: #fff; }
  .scholarship-teaser-button { display: inline-flex; align-items: center; gap: 24px; margin-top: auto; padding: 11px 18px; border-radius: 8px; background: #064d3d; color: #fff; font-size: 14px; font-weight: 700; }
  .scholarship-teaser-button:hover { background: #09654e; }
  .scholarship-teaser-button:focus-visible { outline: 3px solid #b18728; outline-offset: 4px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .scholarship-teaser-link:hover { transform: translateY(-3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scholarship-teaser-link, .scholarship-teaser-arrow { transition: none; }
  }
  @media (max-width: 640px) {
    .scholarship-teaser-body { padding: 20px; }
    .scholarship-teaser-button { width: 100%; min-height: 44px; align-items: center; justify-content: space-between; }
  }
</style>
