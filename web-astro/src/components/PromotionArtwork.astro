---
interface Props {
  image?: string;
  title: string;
  tone?: 'green' | 'cream';
}
const { image, title, tone = 'green' } = Astro.props;
const previewPhoto = tone === 'green' ? '/assets/slide-1-apply.webp' : '/assets/courses/ps-mecha.webp';
---

<div class:list={['promotion-artwork', `promotion-artwork--${tone}`, { 'promotion-artwork--photo': image }]}>
  {image ? (
    <img src={image} alt={title} loading="lazy" />
  ) : (
    <div class="promotion-placeholder" role="img" aria-label="ภาพประกอบจากวิทยาลัย รอภาพโปรโมชั่นจริง">
      <img class="promotion-placeholder-photo" src={previewPhoto} alt="" loading="lazy" />
      <div class="promotion-placeholder-shade" aria-hidden="true"></div>
      <span class="promotion-placeholder-brand" aria-hidden="true">EEC <span>PRIVILEGES<br />FOR YOUR FUTURE</span></span>
      <div class="promotion-placeholder-title" aria-hidden="true">
        <span class="promotion-placeholder-kicker">{tone === 'green' ? 'YOUR NEXT CHAPTER' : 'ROOM TO GROW'}</span>
        <strong>{tone === 'green' ? 'ก้าวใหม่' : 'เปิดประตู'}<br /><span>{tone === 'green' ? 'ที่เป็นคุณ' : 'สู่โอกาส'}</span><svg viewBox="0 0 32 32" fill="none"><path d="M7 25 25 7M7 7h18v18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></strong>
      </div>
      <span class="promotion-placeholder-caption">ภาพประกอบ · รอภาพโปรโมชั่นจริง</span>
    </div>
  )}
</div>

<style>
  .promotion-artwork { width: 100%; height: 100%; min-height: 240px; overflow: hidden; background: var(--green-800); color: white; container-type: inline-size; }
  .promotion-artwork--cream { background: #ecebdd; }
  .promotion-artwork--photo { background: var(--ink-50); }
  .promotion-artwork > img { display: block; width: 100%; height: 100%; min-height: 240px; object-fit: contain; }
  .promotion-placeholder { isolation: isolate; position: relative; display: flex; flex-direction: column; height: 100%; min-height: 240px; padding: 26px; }
  .promotion-placeholder-photo { position: absolute; z-index: -2; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: 18% center; transform: scale(var(--promo-photo-scale, 1)); transition: transform .6s ease; }
  .promotion-artwork--cream .promotion-placeholder-photo { object-position: 61% center; }
  .promotion-placeholder-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(180deg, rgba(1,35,28,.68) 0%, rgba(1,35,28,.05) 38%, rgba(1,35,28,.9) 100%); }
  .promotion-placeholder-brand { display: flex; align-items: center; gap: 10px; font-size: 26px; font-weight: 600; letter-spacing: -.05em; line-height: 1; }
  .promotion-placeholder-brand > span { border-left: 1px solid rgba(255,255,255,.5); padding-left: 10px; font-size: 7px; font-weight: 500; line-height: 1.7; letter-spacing: .13em; }
  .promotion-placeholder-title { margin-top: auto; padding-top: 24px; }
  .promotion-placeholder-kicker { display: block; font-size: 8px; letter-spacing: .16em; margin-bottom: 8px; font-weight: 500; }
  .promotion-placeholder-title strong { position: relative; display: block; font-weight: 500; font-size: clamp(30px, 14cqi, 46px); line-height: 1.3; letter-spacing: -.04em; }
  .promotion-placeholder-title strong > span { color: #ffda64; }
  .promotion-placeholder-title svg { position: absolute; right: 0; bottom: 5px; width: 30px; height: 30px; color: #ffda64; }
  .promotion-placeholder-caption { margin-top: 18px; font-size: 8px; color: #e3eee9; line-height: 1.6; }
  @media (max-width: 600px) {
    .promotion-artwork, .promotion-artwork > img, .promotion-placeholder { min-height: 260px; }
    .promotion-placeholder { padding: 22px; }
    .promotion-placeholder-title { padding-top: 30px; }
    .promotion-placeholder-title strong { font-size: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .promotion-placeholder-photo { transition: none; transform: none; } }
</style>
