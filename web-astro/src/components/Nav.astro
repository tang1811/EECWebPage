---
// Site header — 1:1 port of Nav() from web/app/components/chrome.tsx.
// Active link is computed at BUILD time from Astro.url.pathname (MPA).
// The mobile drawer + scrim render inline (display:none) instead of the old
// React portal; src/scripts/site.ts owns all toggling (scrolled shadow,
// dropdown hover/click, drawer, accordions). Base.astro already omits
// <Nav /> on /admission routes, so the old pathname-null check is gone.
// Icons are inlined verbatim from chrome.tsx Icon (kebab-case SVG attrs).

type Branch = { name: string; slug: string; color?: string };
type Level = { level: string; levelEn: string; color: string; groups: { cat: string; items: Branch[] }[] };

const NAV_COURSE_MENU: Level[] = [
  {
    level: 'ปวช.', levelEn: 'Vocational Cert.', color: '#026451',
    groups: [
      { cat: 'อุตสาหกรรม', items: [
        { name: 'ช่างยนต์', slug: 'yon', color: '#B12B25' },
        { name: 'ช่างไฟฟ้ากำลัง', slug: 'faifaa', color: '#40ABE0' },
        { name: 'ช่างกลโรงงาน', slug: 'gear', color: '#FBD609' },
        { name: 'อิเล็กทรอนิกส์', slug: 'electronic', color: '#0aa183' },
        { name: 'เมคคาทรอนิกส์และหุ่นยนต์', slug: 'mecha', color: '#FBDC6B' },
      ] },
      { cat: 'ดิจิทัล', items: [
        { name: 'ดิจิทัลกราฟิก', slug: 'graphic', color: '#385BF3' },
      ] },
      { cat: 'บริหาร', items: [
        { name: 'เทคโนโลยีธุรกิจดิจิทัล', slug: 'biz-digital', color: '#EB559F' },
        { name: 'การบัญชี', slug: 'accounting', color: '#7B5CA7' },
      ] },
    ],
  },
  {
    level: 'ปวส.', levelEn: 'Higher Cert.', color: '#048269',
    groups: [
      { cat: 'อุตสาหกรรม', items: [
        { name: 'เทคนิคเครื่องกล', slug: 'ps-mech', color: '#B12B25' },
        { name: 'ไฟฟ้า', slug: 'ps-electrical', color: '#40ABE0' },
        { name: 'เทคนิคการผลิต', slug: 'ps-production', color: '#FBD609' },
        { name: 'อิเล็กทรอนิกส์', slug: 'ps-electronic', color: '#0aa183' },
        { name: 'เมคคาทรอนิกส์และหุ่นยนต์', slug: 'ps-mecha', color: '#FBDC6B' },
        { name: 'เทคนิคอุตสาหกรรม', slug: 'ps-industrial', color: '#0aa183' },
      ] },
      { cat: 'ดิจิทัล', items: [
        { name: 'เครือข่ายคอมฯ & ความปลอดภัย', slug: 'ps-network', color: '#EB559F' },
        { name: 'ดิจิทัลกราฟิก', slug: 'ps-graphic', color: '#385BF3' },
      ] },
      { cat: 'บริหาร', items: [
        { name: 'การจัดการโลจิสติกส์', slug: 'ps-logistics', color: '#F26530' },
        { name: 'การบัญชี', slug: 'ps-accounting', color: '#7B5CA7' },
      ] },
    ],
  },
  {
    level: 'ป.ตรี', levelEn: 'Bachelor', color: '#7B5CA7',
    groups: [
      { cat: 'เทคโนโลยีบัณฑิต', items: [
        { name: 'เทคโนโลยีไฟฟ้า', slug: 'pt-electrical', color: '#40ABE0' },
      ] },
    ],
  },
];

const NAV_STUDENT_MENU = [
  { name: 'StudentCare', desc: 'ระบบดูแลช่วยเหลือนักศึกษา · เช็คชื่อ-แจ้งผู้ปกครอง', href: '#', icon: 'shield', color: '#048269' },
  { name: 'E-learning', desc: 'ห้องเรียนออนไลน์ · บทเรียน-ใบงาน-แบบทดสอบ', href: '#', icon: 'book', color: '#385BF3' },
];

const NAV_ITEMS: { id: string; label: string; href: string; dropdown?: string }[] = [
  { id: 'courses',  label: 'หลักสูตร',         href: '/courses/', dropdown: 'courses' },
  { id: 'tuition',  label: 'ค่าเทอม & ทุน',    href: '/tuition/' },
  { id: 'works',    label: 'ผลงาน & นวัตกรรม', href: '/portfolio/' },
  { id: 'about',    label: 'เกี่ยวกับเรา',     href: '/about/' },
  { id: 'personnel',label: 'บุคลากร',          href: '/personnel/' },
  { id: 'contact',  label: 'ติดต่อเรา',        href: '/contact/' },
];

function activeFromPath(pathname: string): string {
  if (pathname.startsWith('/courses')) return 'courses';
  if (pathname.startsWith('/tuition')) return 'tuition';
  if (pathname.startsWith('/portfolio')) return 'works';
  if (pathname.startsWith('/about')) return 'about';
  if (pathname.startsWith('/personnel')) return 'personnel';
  if (pathname.startsWith('/contact')) return 'contact';
  return '';
}
const active = activeFromPath(Astro.url.pathname);

// Verbatim chrome.tsx Icon paths (JSX camelCase attrs → kebab-case HTML).
const ICONS: Record<string, string> = {
  arrow: '<path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  chevronDown: '<path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  sparkle: '<path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2zM18 4l.9 2.1L21 7l-2.1.9L18 10l-.9-2.1L15 7l2.1-.9L18 4z" fill="currentColor"/>',
  shield: '<path d="M12 2l9 4v6c0 5-3.5 9.5-9 10-5.5-.5-9-5-9-10V6l9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/>',
  book: '<path d="M4 4h7a4 4 0 014 4v12a3 3 0 00-3-3H4V4zm16 0h-7a4 4 0 00-4 4v12a3 3 0 013-3h8V4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  close: '<path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  phone: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  facebook: '<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" fill="currentColor"/>',
};
---

<header class="nav  ">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="EEC Engineer Laemchabang Home">
      <img src="/assets/logo.png" alt="EEC Engineer Laemchabang crest" />
      <div class="brand-text">
        <span class="brand-th">วิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย</span>
        <span class="brand-en">EEC Engineer Laemchabang · Sriracha</span>
      </div>
    </a>
    <nav>
      <ul class="nav-links">
        {NAV_ITEMS.map((it) =>
          it.dropdown === 'courses' ? (
            <li class="nav-li-dd">
              <a
                href={it.href}
                class={`nav-link ${active === it.id ? 'active' : ''} `}
                aria-haspopup="menu"
                aria-expanded="false"
              >
                {it.label}
                <svg viewBox="0 0 24 24" class="nav-chev" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.chevronDown} />
              </a>
              <div class="nav-dd " role="menu">
                <div class="nav-dd-inner">
                  <div class="nav-dd-grid">
                    {NAV_COURSE_MENU.map((lvl) => (
                      <div class="nav-dd-col">
                        <div class="nav-dd-level" style={`--lvl:${lvl.color}`}>
                          <span class="nav-dd-level-th">{lvl.level}</span>
                          <span class="nav-dd-level-en">{lvl.levelEn}</span>
                        </div>
                        {lvl.groups.map((g) => (
                          <div class="nav-dd-group">
                            <div class="nav-dd-cat">{g.cat}</div>
                            <ul class="nav-dd-list">
                              {g.items.map((c) => (
                                <li>
                                  <a href={`/courses/${c.slug}/`} class="nav-dd-item">
                                    <span class="nav-dd-dot" style={`background:${c.color}`}></span>
                                    {c.name}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    ))}
                  </div>
                  <div class="nav-dd-foot">
                    <a href="/courses/" class="nav-dd-all">
                      ดูหลักสูตรทั้งหมด (18 สาขา)
                      <svg viewBox="0 0 24 24" class="" style="width:14px;height:14px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.arrow} />
                    </a>
                    <a href="/admission/" class="nav-dd-apply">
                      <svg viewBox="0 0 24 24" class="" style="width:14px;height:14px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.sparkle} />
                      สมัครเรียน 2569
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a href={it.href} class={`nav-link ${active === it.id ? 'active' : ''}`}>{it.label}</a>
            </li>
          )
        )}
      </ul>
    </nav>
    <div class="nav-right">
      <div class="nav-li-dd nav-student-util">
        <button type="button" class="nav-util-link " aria-haspopup="menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" class="" style="width:16px;height:16px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.shield} />
          <span>ระบบนักศึกษา</span>
          <svg viewBox="0 0 24 24" class="nav-chev" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.chevronDown} />
        </button>
        <div class="nav-mini-dd " role="menu">
          <div class="nav-mini-head">ระบบสำหรับนักศึกษา</div>
          {NAV_STUDENT_MENU.map((it) => (
            <a href={it.href} target="_blank" rel="noopener noreferrer" class="nav-mini-item" role="menuitem">
              <span class="nav-mini-ic" style={`--mc:${it.color}`}>
                <svg viewBox="0 0 24 24" class="" style="width:20px;height:20px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS[it.icon]} />
              </span>
              <span class="nav-mini-tx">
                <strong>{it.name}</strong>
                <span>{it.desc}</span>
              </span>
              <svg viewBox="0 0 24 24" class="nav-mini-ext" aria-hidden="true">
                <path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
              </svg>
            </a>
          ))}
        </div>
      </div>
      <a href="/admission/" class="nav-cta">
        สมัครเรียนออนไลน์
        <svg viewBox="0 0 24 24" class="btn-icon" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.arrow} />
      </a>
    </div>
    <button class="nav-burger" aria-label="เปิดเมนู" type="button">
      <svg viewBox="0 0 24 24" class="" style="width:24px;height:24px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.menu} />
    </button>
  </div>
  <div class="mnav-scrim" style="display:none"></div>
  <aside class="mnav-drawer" role="dialog" aria-label="เมนูหลัก" style="display:none">
    <div class="mnav-head">
      <div class="mnav-brand">
        <img src="/assets/logo.png" alt="" />
        <div>
          <div class="mnav-brand-th">EEC Engineer</div>
          <div class="mnav-brand-en">Laemchabang</div>
        </div>
      </div>
      <button class="mnav-close" aria-label="ปิดเมนู">
        <svg viewBox="0 0 24 24" class="" style="width:22px;height:22px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.close} />
      </button>
    </div>
    <nav class="mnav-list" aria-label="เมนูนำทาง">
      {NAV_ITEMS.map((it) => (
        <div>
          {it.dropdown === 'courses' ? (
            <Fragment>
              <button class={`mnav-item mnav-item-btn ${active === it.id ? 'active' : ''}`} aria-expanded="false" data-mnav="courses">
                <span>{it.label}</span>
                <svg viewBox="0 0 24 24" class="mnav-chev " style="width:18px;height:18px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.chevronDown} />
              </button>
              <div class="mnav-sub" style="display:none">
                {NAV_COURSE_MENU.map((lvl) => (
                  <div class="mnav-sub-group">
                    <div class="mnav-sub-lvl" style={`color:${lvl.color};border-color:${lvl.color}`}>
                      {lvl.level} <span>· {lvl.levelEn}</span>
                    </div>
                    {lvl.groups.map((g) => g.items.map((c) => (
                      <a href={`/courses/${c.slug}/`} class="mnav-sub-item">
                        <span class="mnav-dot" style={`background:${c.color}`}></span>
                        {c.name}
                      </a>
                    )))}
                  </div>
                ))}
              </div>
            </Fragment>
          ) : (
            <a href={it.href} class={`mnav-item ${active === it.id ? 'active' : ''}`}>{it.label}</a>
          )}
        </div>
      ))}
      <div>
        <button class="mnav-item mnav-item-btn " aria-expanded="false" data-mnav="student">
          <span>ระบบนักศึกษา</span>
          <svg viewBox="0 0 24 24" class="mnav-chev " style="width:18px;height:18px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.chevronDown} />
        </button>
        <div class="mnav-sub" style="display:none">
          {NAV_STUDENT_MENU.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="mnav-sub-item mnav-sub-sys">
              <span class="mnav-sys-ic" style={`--mc:${s.color}`}>
                <svg viewBox="0 0 24 24" class="" style="width:16px;height:16px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS[s.icon]} />
              </span>
              <span class="mnav-sys-tx">
                <strong>{s.name}</strong>
                <em>{s.desc}</em>
              </span>
              <svg viewBox="0 0 24 24" class="mnav-sys-ext" aria-hidden="true">
                <path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </nav>
    <div class="mnav-foot">
      <a href="/admission/" class="mnav-apply">
        <svg viewBox="0 0 24 24" class="" style="width:16px;height:16px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.sparkle} />
        สมัครเรียนออนไลน์
        <svg viewBox="0 0 24 24" class="" style="width:16px;height:16px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.arrow} />
      </a>
      <div class="mnav-contact">
        <a href="tel:038494066"><svg viewBox="0 0 24 24" class="" style="width:14px;height:14px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.phone} /> 038-494-066</a>
        <a href="https://www.facebook.com/eec.engineer.laemchabang" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" class="" style="width:14px;height:14px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={ICONS.facebook} /> Facebook
        </a>
      </div>
    </div>
  </aside>
</header>
