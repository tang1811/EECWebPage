---
import Base from '../layouts/Base.astro';
import VideoBody from '../components/react/VideoBody';
import { VIDEO_PAGE_ENABLED } from '../config';
import '../styles/homepage.css';
import '../styles/subpages.css';

if (!VIDEO_PAGE_ENABLED) {
  return Astro.redirect('/');
}
---

<Base
  title="วิดีโอแนะนำวิทยาลัย"
  description="วิดีโอแนะนำวิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง — ทัวร์ 1 นาที รู้จักหลักสูตร 18 สาขา พันธมิตรในเขต EEC สถิติ และปรัชญาของเรา"
  path="/video"
  keywords={[
    'วิดีโอแนะนำ วิทยาลัยแหลมฉบัง',
    'ทัวร์ EEC Engineer',
    'หลักสูตร อาชีวศึกษา ศรีราชา',
    'วิทยาลัยเทคโนโลยี ชลบุรี',
  ]}
  mono600
>
  <VideoBody client:load />
</Base>
