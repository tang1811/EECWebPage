---
import Base from '../../layouts/Base.astro';
import AboutStory from '../../components/react/AboutStory';
import { COLLEGE_PHOTO } from '../../data/about-canva-data';
import '../../styles/about-story.css';
---

<Base title="แบบเดิม · เกี่ยวกับเรา" path="/about" mono600>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" as="image" href={COLLEGE_PHOTO.src} fetchpriority="high" />
  </Fragment>
  <AboutStory client:load />
</Base>
