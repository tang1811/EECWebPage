---
import { createHash } from 'node:crypto';
import storySource from '../../components/react/AboutStory.tsx?raw';
import storyStyles from '../../styles/about-story.css?raw';
const draftRevision = createHash('sha256').update(storySource).update(storyStyles).digest('hex').slice(0, 8);
const versions = [
  { id: 'original', name: 'แบบเดิม', note: 'ใช้อยู่ในหน้า About', href: '/about/' },
  { id: 'draft', name: 'แบบใหม่', note: 'ฉบับทดลองสำหรับเปรียบเทียบ', href: `/about/design-preview/?v=${draftRevision}` },
];
const sections = [
  ['opening', 'ส่วนเปิดหน้า'], ['stats', 'ตัวเลขวิทยาลัย'], ['story', 'ประวัติ'],
  ['values', 'ปรัชญา'], ['vision', 'วิสัยทัศน์'], ['people', 'ผู้บริหาร'],
];
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>เปรียบเทียบหน้า About · EEC</title>
    <link rel="icon" href="/assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <header class="compare-heading">
        <div class="compare-title">
          <img src="/assets/logo.png" width="48" height="48" alt="ตราวิทยาลัย EEC" />
          <div><span class="eyebrow">EEC · DESIGN PREVIEW</span><h1>เปรียบเทียบหน้าเกี่ยวกับเรา</h1></div>
        </div>
        <span class="current-status">หน้า About ใช้แบบเดิม</span>
      </header>
      <div class="compare-toolbar">
        <p>เลื่อนดูในแต่ละฝั่งเพื่อเล่นแอนิเมชัน หรือเปิดเต็มหน้าเพื่อดูรายละเอียด</p>
        <div class="device-switch" role="group" aria-label="ขนาดหน้าจอพรีวิว">
          <button type="button" data-device="desktop" aria-pressed="true">จอคอม <span>1440 px</span></button>
          <button type="button" data-device="mobile" aria-pressed="false">มือถือ <span>390 px</span></button>
        </div>
      </div>
      <nav class="section-shortcuts" aria-label="เลื่อนทั้งสองแบบไปยังเนื้อหาเดียวกัน">
        <span>ดูส่วน</span>
        {sections.map(([id, label]) => <button type="button" data-section={id}>{label}</button>)}
      </nav>
      <div class="compare-grid" data-device="desktop">
        {versions.map(version => <section class="compare-panel" aria-labelledby={`${version.id}-title`}>
          <div class="panel-heading">
            <div><h2 id={`${version.id}-title`}>{version.name}</h2><p>{version.note}</p></div>
            <a href={version.href} target="_blank" rel="noopener">เปิดเต็มหน้า <span aria-hidden="true">↗</span><span class="sr-only"> (แท็บใหม่)</span></a>
          </div>
          <div class="preview-stage">
            <iframe id={version.id} src={version.href} title={`หน้าเกี่ยวกับเรา ${version.name} — เลื่อนเพื่อดูแอนิเมชัน`} width="1440" height="1000" loading="eager"></iframe>
          </div>
        </section>)}
      </div>
      <p class="compare-footnote">แบบใหม่เป็นหน้าทดลองแยกต่างหาก เลือกแบบที่ชอบก่อนนำมาใช้กับหน้า About ได้ครับ</p>
      <p id="compare-feedback" class="sr-only" role="status" aria-live="polite"></p>
    </main>
  </body>
</html>

<script>
  const grid = document.querySelector<HTMLElement>('.compare-grid')!;
  const frames = Array.from(document.querySelectorAll<HTMLIFrameElement>('iframe'));
  const deviceButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-device][aria-pressed]'));
  const feedback = document.querySelector<HTMLElement>('#compare-feedback')!;
  let device = matchMedia('(max-width: 700px)').matches ? 'mobile' : 'desktop';
  const selectors: Record<string, [string, string]> = {
    opening: ['.cine-opening', '.about-opening'],
    stats: ['.cine-stats', '.about-stat-band'],
    story: ['.cine-tl-wrap', '#our-story'],
    values: ['.cine-philo-wrap', '#our-values'],
    vision: ['.cine-vision', '#our-vision'],
    people: ['.cine-leaders', '#our-people'],
  };
  function fitPreviews() {
    const width = device === 'mobile' ? 390 : 1440;
    const height = device === 'mobile' ? 844 : 1000;
    grid.dataset.device = device;
    deviceButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.device === device)));
    frames.forEach(frame => {
      const stage = frame.parentElement!;
      const scale = Math.min(1, stage.clientWidth / width);
      frame.style.width = `${width}px`;
      frame.style.height = `${height}px`;
      frame.style.transform = `scale(${scale})`;
      stage.style.height = `${height * scale}px`;
    });
  }
  deviceButtons.forEach(button => button.addEventListener('click', () => {
    device = button.dataset.device!;
    fitPreviews();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-section]').forEach(button => {
    button.addEventListener('click', () => {
      const key = button.dataset.section!;
      let moved = 0;
      frames.forEach((frame, index) => {
        // Both previews belong to this site. If a reader follows a link away,
        // leave that frame alone and keep the full-page links available.
        try {
          const win = frame.contentWindow;
          const doc = frame.contentDocument;
          const section = doc?.querySelector<HTMLElement>(selectors[key][index]);
          if (!win || !doc || !section) return;
          const header = doc.querySelector('header.nav')?.getBoundingClientRect().height ?? 76;
          const chapters = doc.querySelector('.about-chapters')?.getBoundingClientRect().height ?? 0;
          const top = key === 'opening' ? 0 : win.scrollY + section.getBoundingClientRect().top - header - chapters;
          win.scrollTo({ top, behavior: 'instant' });
          moved++;
        } catch { /* A preview may have navigated to an external site. */ }
      });
      feedback.textContent = moved === 2 ? `เลื่อนทั้งสองแบบไปยัง${button.textContent}` : 'บางหน้ายังโหลดไม่เสร็จ หรือออกจากหน้า About แล้ว';
    });
  });
  const resize = new ResizeObserver(fitPreviews);
  frames.forEach(frame => resize.observe(frame.parentElement!));
  fitPreviews();
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f3f3e9; color: #01231c; font-family: 'Prompt', sans-serif; }
  :global(button), :global(a) { -webkit-tap-highlight-color: transparent; }
  :global(button:focus-visible), :global(a:focus-visible), :global(iframe:focus-visible) { outline: 3px solid #b98700; outline-offset: 4px; }
  main { max-width: 1920px; padding: 28px 32px 20px; margin: auto; }
  .compare-heading, .compare-title, .compare-toolbar, .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .compare-title { justify-content: start; gap: 15px; }
  .compare-title img { object-fit: contain; }
  .eyebrow { color: #026451; font-size: 10px; letter-spacing: .15em; }
  h1 { font-size: 24px; font-weight: 600; margin: 3px 0 0; }
  .current-status { font-size: 12px; background: #def5ee; color: #026451; padding: 9px 15px; border-radius: 30px; white-space: nowrap; }
  .current-status::before { content: ''; display: inline-block; width: 6px; height: 6px; background: #026451; border-radius: 50%; margin-right: 8px; }
  .compare-toolbar { margin-top: 25px; padding-block: 20px; border-top: 1px solid #d7ded6; }
  .compare-toolbar p { font-size: 13px; line-height: 1.9; margin: 0; color: #53665d; }
  .device-switch { display: flex; flex-shrink: 0; padding: 4px; border: 1px solid #d7ded6; border-radius: 8px; background: #fff; }
  button { font: inherit; cursor: pointer; }
  .device-switch button { border: 0; border-radius: 5px; background: transparent; color: #52635b; font-size: 13px; padding: 10px 15px; }
  .device-switch button span { font-size: 10px; margin-left: 7px; opacity: .75; }
  .device-switch button[aria-pressed='true'] { color: white; background: #026451; }
  .section-shortcuts { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 20px; }
  .section-shortcuts > span { font-size: 12px; color: #53665d; margin-right: 6px; }
  .section-shortcuts button { background: transparent; color: #026451; border: 1px solid #cbd8ce; border-radius: 5px; padding: 8px 13px; font-size: 12px; min-height: 40px; }
  .section-shortcuts button:hover { background: #def5ee; }
  .compare-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .compare-panel { min-width: 0; border: 1px solid #d7ded6; border-radius: 10px; overflow: hidden; background: white; }
  .panel-heading { padding: 15px 20px; border-bottom: 1px solid #d7ded6; }
  h2 { font-size: 17px; font-weight: 500; margin: 0; }
  .panel-heading p { font-size: 11px; color: #53665d; margin: 3px 0 0; }
  .panel-heading a { color: #026451; font-size: 12px; white-space: nowrap; text-decoration: none; padding-block: 10px; }
  .panel-heading a:hover { text-decoration: underline; }
  .panel-heading a > span:first-child { margin-left: 5px; }
  .preview-stage { position: relative; height: 500px; width: 100%; margin: auto; overflow: hidden; background: white; }
  iframe { display: block; border: 0; transform-origin: top left; }
  .compare-grid[data-device='mobile'] .preview-stage { max-width: 390px; }
  .compare-grid[data-device='mobile'] .compare-panel { background: #e4e9e3; }
  .compare-grid[data-device='mobile'] .panel-heading { background: white; }
  .compare-footnote { font-size: 12px; line-height: 1.8; color: #53665d; margin: 18px 0 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 900px) {
    main { padding: 22px 20px; }
    .compare-heading { align-items: start; }
    h1 { font-size: 20px; }
    .compare-toolbar { align-items: start; flex-direction: column; gap: 15px; }
    .compare-grid { gap: 15px; }
    .panel-heading { padding: 13px; gap: 10px; }
    .panel-heading p { max-width: 145px; }
  }
  @media (max-width: 700px) {
    main { padding: 20px 14px; }
    .compare-heading { flex-direction: column; gap: 15px; }
    .compare-title { gap: 10px; }
    .compare-title img { width: 39px; height: 39px; }
    h1 { font-size: 18px; }
    .compare-toolbar { margin-top: 18px; }
    .compare-grid { grid-template-columns: 1fr; gap: 24px; }
    .panel-heading { padding: 14px 17px; }
    .panel-heading p { max-width: none; }
    .compare-footnote { font-size: 11px; }
  }
</style>
