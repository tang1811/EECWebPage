---
// /news/ — magazine-style listing (SchoolWebV2 design news.html port).
// Lead + two side stories, category chips + text search over the grid,
// upcoming-events calendar with .ics download. Filtering is client-side;
// every card is server-rendered so crawlers see all links.
import Base from '../../layouts/Base.astro';
import '../../styles/homepage.css';
import '../../styles/subpages.css';
import '../../styles/news.css';
import { NEWS, NEWS_LEAD_SLUG, NEWS_SIDE_SLUGS, NEWS_UPCOMING, getNews } from '../../data/news-data';
import { SITE_URL, SITE_NAME } from '../../config';
import type { NewsArticle } from '../../data/news-data';

const lead = getNews(NEWS_LEAD_SLUG)!;
const side = NEWS_SIDE_SLUGS.map((s) => getNews(s)!);
const gridItems = NEWS.filter((n) => n.slug !== NEWS_LEAD_SLUG && !NEWS_SIDE_SLUGS.includes(n.slug));
// Lead/side stories also render as hidden grid cards so category chips and
// search can reach them — the client script swaps the magazine block for the
// full grid whenever a filter or query is active.
const featured = [lead, ...side];

const CATS = ['ทั้งหมด', 'กิจกรรม', 'ประกาศ', 'รับสมัคร', 'รางวัล', 'นศท.'];
const DESCRIPTION =
  'ข่าวสาร ประกาศ และกิจกรรมล่าสุดของวิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง · ปฏิทินกิจกรรมปีการศึกษา 2569';

// Tinted icon-card SVG bodies (from the design's news.html), keyed by NewsArticle.icon.
const ICONS: Record<string, string> = {
  book: '<path d="M4 4h7a4 4 0 014 4v12a3 3 0 00-3-3H4V4zm16 0h-7a4 4 0 00-4 4v12a3 3 0 013-3h8V4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/>',
  award: '<circle cx="12" cy="9" r="6" stroke="currentColor" stroke-width="2" fill="none"/><path d="M8.2 14L6 22l6-3 6 3-2.2-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="2" fill="none"/>',
  shield: '<path d="M12 2l9 4v6c0 5-3.5 9.5-9 10-5.5-.5-9-5-9-10V6l9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/>',
  users: '<circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="2" fill="none"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5M16 4a3 3 0 010 6M19 20c0-2-1.5-3.5-3-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>',
  chip: '<rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><rect x="9" y="9" width="6" height="6" stroke="currentColor" stroke-width="2" fill="none"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
};

const searchText = (n: NewsArticle) => `${n.title} ${n.excerpt} ${n.tag}`.toLowerCase();
const revealDelay = (i: number) => Math.min(i * 0.06, 0.3);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: NEWS.slice(0, 10).map((n, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE_URL}/news/${n.slug}/`,
    name: n.title,
  })),
};
---

<Base
  title="ข่าวสาร & กิจกรรม"
  description={DESCRIPTION}
  path="/news"
  keywords={['ข่าวสารวิทยาลัย', 'กิจกรรมอาชีวะ ชลบุรี', 'EEC Engineer ข่าว']}
  og={{
    title: `ข่าวสาร & กิจกรรม · ${SITE_NAME}`,
    description: DESCRIPTION,
    image: '/assets/news-1-sansamphan-morning.webp',
    type: 'website',
  }}
>
  <main class="news-page">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemList)} />

    <section class="news-top">
      <div class="container">
        <div class="crumbs">
          <a href="/">หน้าแรก</a>
          <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
          <span>ข่าวสาร &amp; กิจกรรม</span>
        </div>
        <h1>ข่าวสาร &amp; <span class="grad">กิจกรรม</span></h1>
        <p>ความเคลื่อนไหวของนักศึกษา ประกาศจากฝ่ายวิชาการ และปฏิทินสำคัญประจำปีการศึกษา 2569</p>
      </div>
    </section>

    <section class="section section-sm" style="padding-top:0" id="newsMag">
      <div class="container">
        <div class="mag">
          <div class="reveal mag-lead">
            <a href={`/news/${lead.slug}/`}>
              <img src={lead.image} alt="" style={lead.objectPosition ? `object-position:${lead.objectPosition}` : undefined} />
              <div class="mag-lead-body">
                <span class="mag-flag">
                  <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2zM18 4l.9 2.1L21 7l-2.1.9L18 10l-.9-2.1L15 7l2.1-.9L18 4z" fill="currentColor"/></svg>ข่าวเด่น
                </span>
                <span class="mag-meta">{lead.tag} · <time datetime={lead.date}>{lead.dateLabel}</time></span>
                <h2>{lead.title}</h2>
                <p>{lead.excerpt}</p>
                <span class="mag-link">อ่านข่าวเต็ม <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></span>
              </div>
            </a>
          </div>
          <div class="mag-side">
            {side.map((n, i) => (
              <div class="reveal mag-item" style={`--reveal-delay:${0.08 * (i + 1)}s`}>
                <a href={`/news/${n.slug}/`}>
                  <div class="mag-item-img"><img src={n.image} alt="" loading="lazy" style={n.objectPosition ? `object-position:${n.objectPosition}` : undefined} /></div>
                  <div class="mag-item-tx">
                    <span class="mag-meta">{n.tag} · <time datetime={n.date}>{n.dateLabel}</time></span>
                    <h3>{n.title}</h3>
                    <p>{n.excerpt}</p>
                    <span class="mag-link">อ่านต่อ <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></span>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section section-sm" style="padding-top:24px">
      <div class="container">
        <div class="reveal news-filters">
          <div class="chip-row" id="chipRow">
            {CATS.map((c, i) => (
              <button type="button" class={i === 0 ? 'chip chip-active' : 'chip'} data-cat={c}>{c}</button>
            ))}
          </div>
          <label class="news-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none"/><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input type="search" id="newsSearch" placeholder="ค้นหาข่าว…" aria-label="ค้นหาข่าว" />
            <button type="button" id="clearSearch" aria-label="ล้างคำค้น" hidden>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </label>
        </div>

        <div class="highlights-grid" id="newsGrid">
          {[...featured.map((n) => ({ n, feat: true })), ...gridItems.map((n) => ({ n, feat: false }))].map(({ n, feat }, i) => (
            <div class="reveal" style={`--reveal-delay:${revealDelay(feat ? 0 : i - featured.length)}s`} data-card data-cat={n.tag} data-text={searchText(n)} data-featured={feat ? 'true' : undefined} hidden={feat}>
              <a href={`/news/${n.slug}/`} class={n.tone ? `hl-card hl-tone-${n.tone}` : 'hl-card'}>
                {n.image ? (
                  <div class="hl-img hl-img-photo"><img src={n.image} alt="" loading="lazy" style={n.objectPosition ? `object-position:${n.objectPosition}` : undefined} /></div>
                ) : (
                  <div class="hl-img hl-img-tone"><svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true" set:html={ICONS[n.icon ?? 'book']} /></div>
                )}
                <div class="hl-body">
                  <span class="hl-tag" style="font-size:16px">{n.tag}</span>
                  <h3 class="hl-t">{n.title}</h3>
                  <p class="hl-d">{n.excerpt}</p>
                  <div class="news-date">
                    <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <time datetime={n.date}>{n.dateLabel}</time>
                  </div>
                  <span class="hl-arrow">อ่านต่อ <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></span>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div class="news-empty" id="newsEmpty" hidden>ไม่พบข่าวที่ตรงกับเงื่อนไข</div>
        <div class="news-loadmore" id="newsMore" hidden>
          <button class="btn btn-ghost" type="button" id="loadMore">โหลดข่าวเพิ่ม<svg viewBox="0 0 24 24" width="16" height="16" class="btn-icon" aria-hidden="true"><path d="M12 5v14M5 13l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></button>
        </div>
      </div>
    </section>

    <section class="section section-sm" style="background:var(--bg-alt);padding-top:64px;padding-bottom:72px">
      <div class="container">
        <div class="reveal section-head" style="margin-bottom:32px">
          <span class="eyebrow">ปฏิทินกิจกรรม</span>
          <h2 class="section-title">กำลังจะถึง</h2>
        </div>
        <div class="cal-list">
          {NEWS_UPCOMING.map((ev, i) => (
            <div class="reveal cal-item" style={`--reveal-delay:${i * 0.06}s`}>
              <div class="cal-date"><strong>{ev.d}</strong><span>{ev.m}</span></div>
              <div class="cal-tx"><h3>{ev.t}</h3><p>{ev.s}</p></div>
              <div class="cal-right">
                <span class="cal-when">{ev.when}</span>
                <button class="cal-add" type="button" data-ics={i}>
                  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>เพิ่มลงปฏิทิน
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script>
    // Category chips + text search + load-more over the server-rendered grid,
    // and .ics download for the upcoming-events calendar (design news-data.js
    // downloadICS). Vanilla port — same behavior as the design's inline script.
    import { NEWS_UPCOMING } from '../../data/news-data';

    const PAGE = 9;
    let cat = 'ทั้งหมด';
    let q = '';
    let limit = PAGE;

    const cards = Array.from(document.querySelectorAll<HTMLElement>('#newsGrid [data-card]'));
    const empty = document.getElementById('newsEmpty');
    const more = document.getElementById('newsMore');
    const btnMore = document.getElementById('loadMore');
    const search = document.getElementById('newsSearch') as HTMLInputElement | null;
    const clear = document.getElementById('clearSearch') as HTMLButtonElement | null;
    const chipRow = document.getElementById('chipRow');
    const mag = document.getElementById('newsMag');

    const apply = () => {
      if (!empty || !more || !btnMore || !clear) return;
      // While a filter/search is active the magazine block gives way to the
      // grid, and the lead/side (featured) cards join the filterable pool —
      // otherwise the นศท./รับสมัคร chips could never match anything.
      const filtering = cat !== 'ทั้งหมด' || !!q;
      if (mag) mag.hidden = filtering;
      const pool = filtering ? cards : cards.filter((c) => !c.dataset.featured);
      const matched = pool.filter(
        (c) => (cat === 'ทั้งหมด' || c.dataset.cat === cat) && (!q || (c.dataset.text ?? '').includes(q))
      );
      cards.forEach((c) => { c.hidden = true; });
      matched.slice(0, limit).forEach((c) => { c.hidden = false; });
      empty.hidden = matched.length > 0;
      const rest = matched.length - Math.min(limit, matched.length);
      more.hidden = rest <= 0;
      if (rest > 0 && btnMore.firstChild) btnMore.firstChild.textContent = `โหลดข่าวเพิ่ม (${rest} ข่าว)`;
      clear.hidden = !q;
      // Nudge the reveal-on-scroll sweep in site.ts so newly unhidden cards
      // animate in without waiting for a real scroll.
      window.dispatchEvent(new Event('scroll'));
    };

    chipRow?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cat]');
      if (!b || !chipRow) return;
      cat = b.dataset.cat ?? 'ทั้งหมด';
      limit = PAGE;
      chipRow.querySelectorAll('button').forEach((x) => x.classList.toggle('chip-active', x === b));
      apply();
    });
    search?.addEventListener('input', () => {
      q = search.value.trim().toLowerCase();
      limit = PAGE;
      apply();
    });
    clear?.addEventListener('click', () => {
      if (search) search.value = '';
      q = '';
      limit = PAGE;
      apply();
    });
    btnMore?.addEventListener('click', () => {
      limit += PAGE;
      apply();
    });

    const downloadICS = (ev: (typeof NEWS_UPCOMING)[number]) => {
      const stamp = (s: string) => s.replace(/[-:]/g, '') + '00';
      const ics = [
        'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//EEC Engineer Laemchabang//TH', 'CALSCALE:GREGORIAN',
        // RFC 5545 requires a VTIMEZONE for every referenced TZID (classic
        // Outlook rejects the file without it). Thailand is fixed UTC+7.
        'BEGIN:VTIMEZONE', 'TZID:Asia/Bangkok',
        'BEGIN:STANDARD', 'DTSTART:19700101T000000', 'TZOFFSETFROM:+0700', 'TZOFFSETTO:+0700', 'TZNAME:+07', 'END:STANDARD',
        'END:VTIMEZONE',
        'BEGIN:VEVENT',
        `UID:${ev.start}-eec@laemchabang`,
        `DTSTAMP:${stamp(new Date().toISOString().slice(0, 16))}Z`,
        `DTSTART;TZID=Asia/Bangkok:${stamp(ev.start)}`,
        `DTEND;TZID=Asia/Bangkok:${stamp(ev.end)}`,
        `SUMMARY:${ev.t}`,
        `DESCRIPTION:${ev.s}`,
        `LOCATION:${ev.loc}`,
        'END:VEVENT', 'END:VCALENDAR',
      ].join('\r\n');
      const url = URL.createObjectURL(new Blob([ics], { type: 'text/calendar;charset=utf-8' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = `${ev.start.slice(0, 10)}-eec.ics`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 100);
    };
    document.querySelectorAll<HTMLButtonElement>('[data-ics]').forEach((b) => {
      b.addEventListener('click', () => {
        const ev = NEWS_UPCOMING[Number(b.dataset.ics)];
        if (ev) downloadICS(ev);
      });
    });

    apply();
  </script>
</Base>
