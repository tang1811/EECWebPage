          <h2 class="section-title">ติดต่อตรงตามฝ่าย</h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px">
          {
            DEPARTMENTS.map((d, i) => (
              <div class="reveal contact-row" style={`background: white; --reveal-delay: ${i * 0.06}s`}>
                <div class="icon">
                  <Icon name={d.icon} style={{ width: 22, height: 22 }} />
                </div>
                <div>
                  <h3>{d.t}</h3>
                  <p style="font-size: 13px; color: var(--ink-500); font-weight: 500; margin-bottom: 4px">{d.s}</p>
                  <button
                    type="button"
                    class="copyable"
                    data-copy={d.tel.replace(/[^0-9]/g, '')}
                    data-label="เบอร์โทร"
                    data-href={`tel:${d.tel.replace(/[^0-9]/g, '')}`}
                    aria-label={`คัดลอกเบอร์โทร: ${d.tel}`}
                    title="กดเพื่อคัดลอก · ดับเบิลคลิกเพื่อเปิด"
                  >{d.tel}<svg viewBox="0 0 24 24" class="copy-ic" aria-hidden="true"><path d="M8 4h10a2 2 0 012 2v10M16 8H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-10a2 2 0 00-2-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none" /></svg></button>
