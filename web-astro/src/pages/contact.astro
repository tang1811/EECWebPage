---
// ─────────────────────────────────────────────────────────────
// Contact page — ติดต่อเรา. Ported from web/app/contact/page.tsx +
// ContactBody.tsx. Static markup + vanilla scripts: live office-hours
// badge, tap-to-copy, share location, embedded map + directions bar.
// ─────────────────────────────────────────────────────────────
import Base from '../layouts/Base.astro';
import { Icon } from '../components/react/chrome-lite';
import '../styles/homepage.css';
import '../styles/subpages.css';

// ── Geo for the college (for map deep-links) ─────────────
const GEO = { lat: 13.086485, lng: 100.936589 };
const GEO_STR = `${GEO.lat},${GEO.lng}`;

// ── Department contacts data ─────────────────────────────
