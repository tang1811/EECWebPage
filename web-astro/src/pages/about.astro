---
import Base from '../layouts/Base.astro';
import AboutBody from '../components/react/AboutBody';
import { SITE_NAME } from '../config';
import { COLLEGE_PHOTO } from '../data/about-canva-data';
import '../styles/about-information.css';

const description = 'รู้จักเทคโนแหลมฉบัง ปรัชญาวิทยาลัย การเรียน ปวช. ปวส. และปริญญาตรีต่อเนื่อง พร้อมภาพอาคาร บรรยากาศการเรียน และห้องปฏิบัติการของแต่ละแผนก';
---

<Base
  title="เกี่ยวกับเรา"
  description={description}
  path="/about"
  keywords={[
    'เกี่ยวกับ วิทยาลัยแหลมฉบัง',
    'ประวัติ EEC Engineer',
    'ปรัชญา วิทยาลัยเทคโนโลยี ชลบุรี',
    'พันธกิจ อาชีวศึกษา ศรีราชา',
  ]}
  og={{ title: `เกี่ยวกับเรา · ${SITE_NAME}`, description, image: COLLEGE_PHOTO.src }}
>
  <AboutBody />
</Base>
