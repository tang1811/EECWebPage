---
import Base from '../layouts/Base.astro';
import AboutStory from '../components/react/AboutStory';
import { SITE_NAME } from '../config';
import '../styles/about-story.css';

const description = 'รู้จักเทคโนแหลมฉบัง ปรัชญาวิทยาลัย การเรียน ปวช. ปวส. และปริญญาตรีต่อเนื่อง พร้อมภาพอาคาร บรรยากาศการเรียน และห้องปฏิบัติการของแต่ละแผนก';
const firstBanner = '/assets/about/banner/about-1.webp';
---

<Base
  title="เกี่ยวกับเรา"
  description={description}
  path="/about"
  keywords={[
    'เกี่ยวกับ วิทยาลัยแหลมฉบัง',
    'ประวัติ EEC Engineer',
    'ปรัชญา วิทยาลัยเทคโนโลยี ชลบุรี',
    'พันธกิจ อาชีวศึกษา ศรีราชา',
  ]}
  og={{ title: `เกี่ยวกับเรา · ${SITE_NAME}`, description, image: firstBanner }}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={firstBanner} fetchpriority="high" />
  </Fragment>
  <AboutStory client:load enhancedHistory />
</Base>
