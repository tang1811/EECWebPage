---
// Homepage — ported from web/app/page.tsx + web/app/components/homepage.tsx.
// Markup parity: every class/style string replicates the old React render
// (including Reveal's `reveal ${dirClass} ${className}` double-space output).
import Base from '../layouts/Base.astro';
import { DEFAULT_KEYWORDS } from '../config';
import { Icon } from '../components/react/chrome-lite';
import { FAQS } from '../data/faq-data';
import { NEWS } from '../data/news-data';
import INNOV from '../../public/assets/portfolio/innovation/innovation.json';
import '../styles/homepage.css';

const FAQ_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
