<script>
  // ── Hero slideshow (homepage.tsx HeroSlideshow, vanilla port) ──
  function initSlideshow(): void {
    const section = document.querySelector<HTMLElement>('.hero-slideshow');
    if (!section) return;
    const stage = section.querySelector<HTMLElement>('.hss-stage');
    const slides = Array.from(section.querySelectorAll<HTMLElement>('.hss-slide'));
    const copies = Array.from(section.querySelectorAll<HTMLElement>('.hss-copy'));
    const bars = Array.from(section.querySelectorAll<HTMLElement>('.hss-prog-bar'));
    const navs = Array.from(section.querySelectorAll<HTMLButtonElement>('.hss-nav'));
    const counterEl = section.querySelector<HTMLElement>('.hss-counter strong');
    const N = slides.length;
    const DURATION = 6500;
    const SWIPE_THRESHOLD = 60;

    let idx = 0;
    let paused = false;
    let dragActive = false;
    let dragStartX = 0;
    let dragDx = 0;
    let suppressClick = false;
    let timer: number | undefined;

    const render = () => {
      slides.forEach((s, i) => {
        s.classList.toggle('on', idx === i);
        s.classList.toggle('next', idx === i - 1 || (idx === N - 1 && i === 0));
        s.setAttribute('aria-hidden', String(idx !== i));
      });
      copies.forEach((c, i) => {
        c.classList.toggle('on', idx === i);
        c.setAttribute('aria-hidden', String(idx !== i));
      });
      bars.forEach((b, i) => {
        b.classList.toggle('on', i === idx);
        b.classList.toggle('done', i < idx);
        // React remounted the fill on every idx change (key={`${idx}-${i}`});
        // recreating the node restarts the CSS progress animation identically.
        const fill = b.querySelector('.hss-prog-fill');
        if (fill) {
          const fresh = document.createElement('span');
          fresh.className = 'hss-prog-fill';
          fill.replaceWith(fresh);
        }
      });
      if (counterEl) counterEl.textContent = String(idx + 1).padStart(2, '0');
    };

    const updateStage = () => {
      const dragOffset = dragActive ? Math.max(-120, Math.min(120, dragDx)) : 0;
      if (stage) stage.style.transform = dragOffset ? `translateX(${dragOffset * 0.3}px)` : 'none';
    };

    // Interval resets only when paused/drag state changes (React effect deps
    // were [paused, drag.active] — manual go() did NOT reset the timer).
    const updateTimer = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
      if (!paused && !dragActive) {
        timer = window.setInterval(() => {
          idx = (idx + 1) % N;
          render();
        }, DURATION);
      }
    };

    const go = (n: number) => {
      idx = (n + N) % N;
      render();
    };

    const endDrag = () => {
      if (!dragActive) return;
      const dx = dragDx;
      if (Math.abs(dx) > SWIPE_THRESHOLD) go(dx < 0 ? idx + 1 : idx - 1);
      suppressClick = Math.abs(dx) > 8;
      dragActive = false;
      dragStartX = 0;
      dragDx = 0;
      section.classList.remove('is-dragging');
      updateStage();
      updateTimer();
    };

    section.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      if ((e.target as HTMLElement).closest('button, a, [role="tab"]')) return;
      suppressClick = false;
      dragActive = true;
      dragStartX = e.clientX ?? 0;
      dragDx = 0;
      section.classList.add('is-dragging');
      updateStage();
      updateTimer();
      try {
        section.setPointerCapture(e.pointerId);
      } catch {
        /* noop */
      }
    });
    section.addEventListener('pointermove', (e) => {
      if (!dragActive) return;
      dragDx = (e.clientX ?? 0) - dragStartX;
      updateStage();
    });
    section.addEventListener('pointerup', endDrag);
    section.addEventListener('pointercancel', endDrag);
    section.addEventListener('mouseenter', () => {
      paused = true;
      updateTimer();
    });
    section.addEventListener('mouseleave', () => {
      paused = false;
      if (dragActive) endDrag();
      updateTimer();
    });

    if (navs[0]) navs[0].addEventListener('click', () => go(idx - 1));
    if (navs[1]) navs[1].addEventListener('click', () => go(idx + 1));
    bars.forEach((b, i) => b.addEventListener('click', () => go(i)));

    // Suppress CTA navigation after a real drag (>8px), like the old onClick guard.
    section.querySelectorAll<HTMLAnchorElement>('.hss-cta a').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (suppressClick) {
          e.preventDefault();
          suppressClick = false;
        }
      });
    });

    updateTimer();
  }

  // ── Animated counters (homepage.tsx AnimatedCounter) ──
  function initCounters(): void {
    document.querySelectorAll<HTMLElement>('span[data-target]').forEach((el) => {
      const target = Number(el.dataset.target || '0');
      const suffix = el.dataset.suffix || '';
      const duration = Number(el.dataset.duration || '1800');
      // React rendered 0 until the counter intersected; static HTML carries the
      // final number for no-JS/SEO, then JS resets and counts up identically.
      el.textContent = (0).toLocaleString() + suffix;
      let started = false;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || started) return;
            started = true;
            io.disconnect();
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / duration);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = Math.floor(target * eased).toLocaleString() + suffix;
              if (t < 1) requestAnimationFrame(tick);
              else el.textContent = target.toLocaleString() + suffix;
            };
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.4 }
      );
      io.observe(el);
    });
  }

  // ── Course category filter (homepage.tsx Courses) ──
  function initCourseFilter(): void {
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.course-filters .chip'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.course-grid [data-cat]'));
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.cat || 'ทั้งหมด';
        chips.forEach((c) => c.classList.toggle('chip-active', c === chip));
        cards.forEach((card) => {
          card.style.display = cat === 'ทั้งหมด' || card.dataset.cat === cat ? '' : 'none';
        });
      });
    });
  }

  // ── Testimonials carousel (homepage.tsx Testimonials) ──
  function initTestimonials(): void {
    const track = document.querySelector<HTMLElement>('.testi-track');
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.testi-dot'));
    if (!track || dots.length === 0) return;
    let idx = 0;
    const render = () => {
      track.style.transform = `translateX(-${idx * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('on', idx === i));
    };
    // Interval set once on mount ([] deps) — dot clicks never reset it.
    setInterval(() => {
      idx = (idx + 1) % dots.length;
      render();
    }, 6000);
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        idx = i;
        render();
      })
    );
  }

  // ── FAQ single-open accordion (homepage.tsx FAQ) ──
  function initFaq(): void {
    const items = Array.from(document.querySelectorAll<HTMLElement>('.faq-list .faq-item'));
    const PLUS_D = 'M12 5v14M5 12h14';
    const MINUS_D = 'M5 12h14';
    let open = 0;
    const render = () => {
      items.forEach((item, i) => {
        const isOpen = open === i;
        item.classList.toggle('open', isOpen);
        const path = item.querySelector('.faq-q svg path');
        if (path) path.setAttribute('d', isOpen ? MINUS_D : PLUS_D);
      });
    };
    items.forEach((item, i) => {
      item.addEventListener('click', () => {
        open = open === i ? -1 : i;
        render();
      });
    });
  }

  initSlideshow();
  initCounters();
  initCourseFilter();
  initTestimonials();
  initFaq();
</script>
