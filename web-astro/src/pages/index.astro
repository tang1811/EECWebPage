---
// Homepage — ported from web/app/page.tsx + web/app/components/homepage.tsx.
// Markup parity: every class/style string replicates the old React render
// (including Reveal's `reveal ${dirClass} ${className}` double-space output).
import Base from '../layouts/Base.astro';
import HomeQuickLinks from '../components/HomeQuickLinks.astro';
import Promotions from '../components/Promotions.astro';
import { DEFAULT_KEYWORDS } from '../config';
import { Icon } from '../components/react/chrome-lite';
import { FAQS } from '../data/faq-data';
import { NEWS } from '../data/news-data';
import { COURSES } from '../data/course-data';
import INNOV from '../../public/assets/portfolio/innovation/innovation.json';
import '../styles/homepage.css';

const FAQ_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

type HpProject = { id: string; type: string; title: string; titleEn: string; cover: string; photos: string[] };
const HP_PROJECTS = INNOV as HpProject[];

// ── Image-only hero slideshow ─────────────────────────────
const SLIDES = [
  { img: '/assets/slide-1-apply.webp', alt: 'บัณฑิตวิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง' },
  { img: '/assets/slide-2-eec.webp', alt: 'กิจกรรมในหอประชุมวิทยาลัย' },
  { img: '/assets/slide-3-innovation.webp', alt: 'คณะบุคลากรหน้าอาคารอำนวยการวิทยาลัย' },
  { img: '/assets/slide-4-community.webp', alt: 'ภาพหมู่คณะบุคลากรวิทยาลัย' },
];

// Photo articles only — icon-card news (no image) can't fill the hl-img slot.
const HIGHLIGHT_NEWS = NEWS.filter((n) => n.image && !n.promotion).slice(0, 3);

// The course count follows the enabled public catalog.
const STATS = [
  { v: 30, s: '+', l: 'ปีแห่งประสบการณ์' },
  { v: COURSES.length, s: '', l: 'หลักสูตร' },
  { v: 12000, s: '+', l: 'ศิษย์เก่า' },
  { v: 100, s: '%', l: 'มีงานทำ / ศึกษาต่อ' },
  { v: 50, s: '+', l: 'พันธมิตรองค์กร' },
];

// No brand marquee under the stats. One was added here and pushed up to
// SchoolWebV2, then removed from the design again, so the site follows.
// The .marquee rules in homepage.css stay unused — as they were before,
// and as they still are in the design's own homepage.css.

const GRAD_STATS = [
  { v: 83, s: '%', l: 'ปวส. มีงานทำ', sub: 'หลังสำเร็จการศึกษา' },
  { v: 16, s: '%', l: 'ปวส. ศึกษาต่อ', sub: 'ระดับสูงขึ้น' },
  { v: 89, s: '%', l: 'ปวช. ศึกษาต่อ', sub: 'ต่อ ปวส. / ป.ตรี' },
  { v: 12500, s: '฿', l: 'เงินเดือนเริ่มต้น', sub: 'เฉลี่ย (ปวส.) ต่อเดือน' },
];
const EMPLOYERS = ['ปตท.', 'Mitsubishi', 'Caterpillar', 'เคียวเดน', 'ซูมิเดน สตีล', 'AGC', 'ซัมมิท ออโต้บอดี้', 'อีสเทิร์น คอนทรานส์'];

const CATS = ['ทั้งหมด', 'อุตสาหกรรม', 'ดิจิทัล', 'บริหาร'];
const HOME_COURSE_LIMIT = 10;
const HOME_MOBILE_COURSE_LIMIT = 5;

const PHILOSOPHY = [
  { t: 'มุ่งสร้างคนดี', d: 'มุ่งหวังที่จะสร้างนักศึกษาให้เป็นคนดีทั้งต่อตนเองและสังคม', icon: 'users' },
  { t: 'มีระเบียบวินัย', d: 'ความมีระเบียบแบบแผนและวินัย เป็นแนวทางการปฏิบัติตน', icon: 'check' },
  { t: 'ก้าวไกลเทคโนโลยี', d: 'พัฒนาเทคโนโลยีให้เจริญก้าวหน้าทันยุคทันสมัย', icon: 'chip' },
  { t: 'ฝีมือเยี่ยม', d: 'มีฝีมือและทักษะทางวิชาชีพระดับสูง พร้อมปฏิบัติงานจริง', icon: 'award' },
  { t: 'เปี่ยมคุณธรรม', d: 'มีคุณธรรม จริยธรรม ค่านิยมที่ดี ยึดถือวัฒนธรรมและประเพณีอันดีงาม', icon: 'shield' },
];

const TESTIMONIALS = [
  { name: 'นางสาว บงกช สินฉาย', dept: 'สาขา การจัดการโลจิสติกส์', text: 'เรียนที่นี่เหมือนเรียนกับครอบครัวค่ะ ทุกคนเพื่อนและอาจารย์ทุกท่านให้ความเป็นกันเอง สงสัยอะไรเมื่อไหร่ให้คำตอบได้เสมอ', avatar: 'บ', color: '#0f7a3e' },
  { name: 'นาย ฉัตรชัย สุขภักดี', dept: 'สาขา โลจิสติกส์ ปวส.2', text: 'ได้ความรู้ที่แน่นและเป็นประโยชน์ต่อการใช้ในอาชีพได้จริง และมีความสุขทุกครั้งที่เรียนครับ', avatar: 'ฉ', color: '#1c2a4e' },
  { name: 'นางสาว ปุณณภา พรมชาติ', dept: 'สาขา โลจิสติกส์', text: 'เป็นสถาบันที่ให้ความรู้และความเข้าใจดีมาก สามารถนำไปใช้ในที่ทำงานจริงและชีวิตจริงได้ดี การเรียนการสอนของอาจารย์ทุกท่านเข้าใจง่ายและเป็นกันเอง', avatar: 'ป', color: '#8a1f2b' },
  { name: 'นาย แหวนเพชร จุพิมาย', dept: 'แผนก โลจิสติกส์ ปวส.2', text: 'ผมมีความสุขที่ได้เรียนรู้ ได้พบเพื่อนใหม่ ได้รับความห่วงใย จากอาจารย์ทุกท่าน', avatar: 'ห', color: '#22a85a' },
];
---

<Base keywords={DEFAULT_KEYWORDS} path="">
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/slide-1-apply.webp" fetchpriority="high" />
  </Fragment>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(FAQ_JSONLD)} />
  {/* Keep the page heading accessible while the hero displays only photographs. */}
  <h1 style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
    วิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง — เปิดรับสมัครนักศึกษาใหม่ ปวช. ปวส. ป.ตรี ปีการศึกษา 2569
  </h1>

  <main>
    {/* ── Hero Slideshow ── */}
    <section class="hero hero-slideshow" aria-label="ภาพกิจกรรมวิทยาลัย" style="touch-action:pan-y;user-select:none">
      <div class="hss-stage" style="transform:none">
        {SLIDES.map((s, i) => (
          <div class:list={['hss-slide', { on: i === 0 }]} aria-hidden={i !== 0 ? 'true' : 'false'}>
            <img src={s.img} alt={s.alt} class="hss-img" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} draggable="false" />
          </div>
        ))}
      </div>
      <div class="hss-progress" role="group" aria-label="เลือกสไลด์">
        {SLIDES.map((_s, i) => (
          <button type="button" class:list={['hss-prog-bar', { on: i === 0 }]} aria-label={`ไปสไลด์ ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="hss-prog-fill" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </section>

    <HomeQuickLinks />

    <Promotions />

    {/* ── Highlights / News strip ── */}
    <section class="section section-sm highlights-section" id="highlights">
      <div class="container">
        <div class="reveal  highlights-head" style="--reveal-delay:0s">
          <span class="eyebrow">ข่าวสารล่าสุด</span>
          <a href="/news/" class="highlights-all">ดูทั้งหมด <Icon name="arrow" style={{ width: 16, height: 16 }} /></a>
        </div>
        <div class="highlights-grid">
          {HIGHLIGHT_NEWS.map((n, i) => (
            <div class="reveal  " style={`--reveal-delay:${i * 0.08}s`}>
              <a href={`/news/${n.slug}/`} class="hl-card">
                <div class="hl-img hl-img-photo">
                  <img src={n.image} alt={n.title} loading="lazy" style={`object-position:${n.objectPosition}`} />
                </div>
                <div class="hl-body">
                  <span class="hl-tag" style="font-size:16px">{n.tag}</span>
                  <h3 class="hl-t">{n.title}</h3>
                  <p class="hl-d">{n.excerpt}</p>
                  <span class="hl-arrow">อ่านต่อ <Icon name="arrow" style={{ width: 14, height: 14 }} /></span>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Stats bar ── */}
    <section class="stats-bar">
      <div class="container">
        <div class="stats-grid">
          {STATS.map((s, i) => (
            <div class="reveal  stat-item" style={`--reveal-delay:${i * 0.06}s`}>
              <div class="stat-v"><span data-target={String(s.v)} data-suffix={s.s} data-duration={String(1500 + i * 100)}>{s.v.toLocaleString()}{s.s}</span></div>
              <div class="stat-l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Courses (lift cards) ── */}
    <section class="section" id="courses">
      <div class="container">
        <div class="reveal  section-head" style="--reveal-delay:0s">
          <span class="eyebrow">หลักสูตรของเรา</span>
          <h2 class="section-title">
            {COURSES.length} หลักสูตร <span class="grad">ครอบคลุมทุกสายอาชีพ</span>
          </h2>
          <p class="section-sub">เรียนกับอาจารย์ที่มีประสบการณ์จริงในอุตสาหกรรม พร้อมห้องปฏิบัติการมาตรฐาน และเครื่องมือทันสมัย</p>
        </div>
        <div class="reveal  course-filters" style="--reveal-delay:0.1s">
          {CATS.map((c, i) => (
            <button type="button" class={`chip ${i === 0 ? 'chip-active' : ''}`} data-cat={c} aria-pressed={i === 0}>
              {c}
            </button>
          ))}
        </div>
        <div class="course-grid card-lift" data-limit={HOME_COURSE_LIMIT} data-mobile-limit={HOME_MOBILE_COURSE_LIMIT}>
          {COURSES.map((c, i) => (
            <div class:list={['reveal reveal-scale', { 'mobile-course-overflow': i >= HOME_MOBILE_COURSE_LIMIT }]} style={`--reveal-delay:${Math.min(i * 0.04, 0.4)}s`} data-cat={c.cat} hidden={i >= HOME_COURSE_LIMIT}>
              <a href={`/courses/${c.slug}/`} class="course-card cc-lift" style={c.color ? `--dept:${c.color}` : undefined}>
                {c.img && (
                  <div class="cc-photo">
                    <img src={c.img} alt="" loading="lazy" />
                    {c.hot && <span class="cc-hot">HOT</span>}
                    {c.color && <div class="cc-color-bar" style={`background:${c.color}`}></div>}
                  </div>
                )}
                {!c.img && c.hot && <span class="cc-hot">HOT</span>}
                <div class="cc-body">
                  <div class="cc-code">{c.code} · {c.cat}</div>
                  <h3 class="cc-name">{c.name}</h3>
                  <div class="cc-foot">
                    <span style="height:20px;font-size:16px">ดูรายละเอียด</span>
                    <Icon name="arrow" style={{ width: 18, height: 18 }} />
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div style="margin-top:32px;text-align:center">
          <a href="/courses/" class="btn btn-ghost">ดูหลักสูตรทั้งหมด <Icon name="arrow" className="btn-icon" /></a>
        </div>
      </div>
    </section>

    {/* ── About / Philosophy ── */}
    <section class="section about-section">
      <div class="container about-grid">
        <div class="reveal reveal-left about-copy" style="--reveal-delay:0s">
          <span class="eyebrow">ปรัชญาวิทยาลัย</span>
          {/* No <h2> here — matches SchoolWebV2's About, which goes straight
              from the eyebrow to the lede. Chosen by the user over the old
              "เปี่ยมคุณธรรม / มุ่งสร้างคนดี" heading. */}
          <p class="section-sub">
            ตั้งแต่ปี พ.ศ. 2538 วิทยาลัยฯ ได้ผลิตช่างฝีมือคุณภาพให้แก่นิคมอุตสาหกรรมตะวันออก ปลูกฝังทั้งวิชาชีพและจริยธรรมควบคู่กัน
          </p>
          <div class="about-stats">
            <div><strong>30+</strong><span>ปี</span></div>
            <div><strong>1995</strong><span>ก่อตั้ง</span></div>
            <div><strong>5</strong><span>หลักธรรม</span></div>
          </div>
          <a href="/about/" class="btn btn-primary">เรียนรู้เพิ่มเติม<Icon name="arrow" className="btn-icon" /></a>
        </div>
        <div class="reveal reveal-right philosophy-stack" style="--reveal-delay:0s">
          {PHILOSOPHY.map((p, i) => (
            <div class="philo-row" style={`--i:${i}`}>
              <div class="philo-icon"><Icon name={p.icon} style={{ width: 22, height: 22 }} /></div>
              <div>
                <h3 class="philo-t">{p.t}</h3>
                <p class="philo-d">{p.d}</p>
              </div>
              <div class="philo-num">0{i + 1}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Graduate outcomes (จบแล้วมีงานทำ) ── */}
    <section class="section grad-section" id="outcomes">
      <div class="container">
        <div class="reveal  section-head" style="text-align:center;--reveal-delay:0s">
          <span class="eyebrow">จบแล้วไปไหน</span>
          <h2 class="section-title">เรียนจบ <span class="grad">มีงานทำจริง</span></h2>
          <p class="section-sub">บัณฑิตสายอาชีพที่ตลาดอุตสาหกรรมตะวันออกต้องการ — มีงานรองรับและเส้นทางเติบโตชัดเจน</p>
        </div>
        <div class="grad-grid">
          {GRAD_STATS.map((s, i) => (
            <div class="reveal  grad-card" style={`--reveal-delay:${i * 0.07}s`}>
              <div class="grad-v"><span data-target={String(s.v)} data-suffix={s.s} data-duration={String(1500 + i * 120)}>{s.v.toLocaleString()}{s.s}</span></div>
              <div class="grad-l">{s.l}</div>
              <div class="grad-sub">{s.sub}</div>
            </div>
          ))}
        </div>
        <div class="reveal  grad-employers" style="--reveal-delay:0.1s">
          <span class="grad-emp-label">ศิษย์เก่าทำงานที่</span>
          <div class="grad-emp-list">
            {EMPLOYERS.map((e) => <span class="grad-emp-chip">{e}</span>)}
            <span class="grad-emp-chip grad-emp-more">และอีกหลายแห่ง</span>
          </div>
        </div>
        <p class="grad-foot">
          * ข้อมูลผู้สำเร็จการศึกษา ปีการศึกษา 2565 จากการสำรวจภาวะการมีงานทำ/ศึกษาต่อ เฉพาะผู้ที่ติดตามได้ 268 คน (ปวช. 138 · ปวส. 130)
        </p>
      </div>
    </section>

    {/* ── Portfolio preview ── */}
    <section class="section portfolio-section">
      <div class="container">
        <div class="reveal  section-head" style="text-align:center;--reveal-delay:0s">
          <span class="eyebrow">ผลงานวิทยาลัย</span>
          <h2 class="section-title">
            นวัตกรรม สิ่งประดิษฐ์ <span class="grad">ลงมือทำจริง</span>
          </h2>
          <p class="section-sub">ผลงานและกิจกรรมจริงของนักศึกษา ปีการศึกษา 2568 — ดูภาพและรายละเอียดเพิ่มเติมได้</p>
        </div>
        <div class="hp-proj-grid">
          {HP_PROJECTS.map((p, i) => (
            <div class="reveal reveal-scale " style={`--reveal-delay:${i * 0.06}s`}>
              <a href="/portfolio/" class="hp-proj-card">
                <div class="hp-proj-cover">
                  <img src={p.cover} alt={p.title} loading="lazy" />
                  <span class="hp-proj-type">{p.type}</span>
                  <span class="hp-proj-count">{p.photos.length} ภาพ</span>
                </div>
                <div class="hp-proj-meta">
                  <h3>{p.title}</h3>
                  <span class="hp-proj-en">{p.titleEn} <Icon name="arrow" style={{ width: 14, height: 14 }} /></span>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div style="text-align:center;margin-top:48px">
          <a href="/portfolio/" class="btn btn-ghost btn-lg">ดูผลงานทั้งหมด <Icon name="arrow" className="btn-icon" /></a>
        </div>
      </div>
    </section>

    {/* ── Testimonials ── */}
    <section class="section testimonials-section">
      <div class="testi-bg" aria-hidden="true"></div>
      <div class="container">
        <div class="reveal  section-head" style="text-align:center;--reveal-delay:0s">
          <span class="eyebrow" style="background:rgba(255,255,255,0.12);color:var(--green-200)">เสียงจากนักศึกษา</span>
          <h2 class="section-title" style="color:white">
            ครอบครัวที่ <span class="grad-light">ส่งเสริมให้คุณเติบโต</span>
          </h2>
        </div>
        <div class="testi-carousel" style="touch-action:pan-y;user-select:none">
          <div class="testi-track" style="transform:translateX(-0%)">
            {TESTIMONIALS.map((t) => (
              <div class="testi-slide">
                <div class="testi-card">
                  <Icon name="quote" style={{ width: 48, height: 48, color: 'var(--green-300)' }} />
                  <p class="testi-text">{t.text}</p>
                  <div class="testi-author">
                    <div class="testi-avatar" style={`background:${t.color}`}>{t.avatar}</div>
                    <div>
                      <div class="testi-name">{t.name}</div>
                      <div class="testi-dept">{t.dept}</div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="testi-dots">
            {TESTIMONIALS.map((_t, i) => (
              <button class={`testi-dot ${i === 0 ? 'on' : ''}`} aria-label={`testimonial ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── FAQ ── */}
    <section class="section faq-section" id="faq">
      <div class="container faq-grid">
        <div class="reveal reveal-left faq-side" style="--reveal-delay:0s">
          <span class="eyebrow">FAQ</span>
          <h2 class="section-title">คำถามที่ <span class="grad">พบบ่อย</span></h2>
          <p class="section-sub">รวบรวมคำถามที่ผู้ปกครองและนักศึกษาสอบถามเข้ามาบ่อยที่สุด หากยังไม่พบคำตอบ ติดต่อเราได้ทันที</p>
          <a href="/contact/" class="btn btn-primary" style="margin-top:24px">
            <Icon name="phone" style={{ width: 16, height: 16 }} /> สอบถามเพิ่มเติม
          </a>
        </div>
        <div class="reveal reveal-right faq-list" style="--reveal-delay:0s">
          {FAQS.map((f, i) => (
            <div class={`faq-item ${i === 0 ? 'open' : ''}`}>
              <div class="faq-q">
                <span class="faq-num">0{i + 1}</span>
                <span class="faq-q-text">{f.q}</span>
                <Icon name={i === 0 ? 'minus' : 'plus'} style={{ width: 20, height: 20, color: 'var(--green-700)' }} />
              </div>
              <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── CTA banner ── */}
    <section class="section cta-section">
      <div class="container">
        <div class="reveal reveal-scale cta-banner" style="--reveal-delay:0s">
          <div class="cta-bg-mesh"></div>
          <div class="cta-content">
            <span class="eyebrow" style="background:rgba(255,255,255,0.18);color:white">เปิดรับสมัคร</span>
            <h2 class="cta-title">พร้อมเริ่มต้นเส้นทาง<br /><span class="grad-light">อาชีพที่ใช่</span>หรือยัง?</h2>
            <p class="cta-sub">สมัครออนไลน์ใช้เวลาเพียง 5 นาที — ทีมงานติดต่อกลับภายใน 24 ชม.</p>
            <div class="cta-actions">
              <a href="/admission/" class="btn btn-white btn-lg">สมัครเรียนออนไลน์<Icon name="arrow" className="btn-icon" /></a>
              <a href="tel:038494066" class="btn btn-ghost btn-lg" style="color:white;border-color:rgba(255,255,255,0.4)">
                <Icon name="phone" style={{ width: 16, height: 16 }} /> 038-494-066
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // ── Image hero: autoplay, progress navigation, and pointer swipe ──
  function initSlideshow(): void {
    const section = document.querySelector<HTMLElement>('.hero-slideshow');
    if (!section) return;
    const stage = section.querySelector<HTMLElement>('.hss-stage');
    const slides = Array.from(section.querySelectorAll<HTMLElement>('.hss-slide'));
    const bars = Array.from(section.querySelectorAll<HTMLButtonElement>('.hss-prog-bar'));
    const N = slides.length;
    if (N < 2) return;
    const DURATION = 6500;
    const SWIPE_THRESHOLD = 60;
    section.style.setProperty('--hss-duration', `${DURATION}ms`);

    let idx = 0;
    let dragActive = false;
    let dragStartX = 0;
    let dragDx = 0;
    let timer: number | undefined;

    const go = (n: number) => {
      idx = (n + N) % N;
      slides.forEach((slide, i) => {
        slide.classList.toggle('on', idx === i);
        slide.setAttribute('aria-hidden', String(idx !== i));
      });
      bars.forEach((bar, i) => {
        bar.classList.toggle('on', idx === i);
        bar.classList.toggle('done', i < idx);
        bar.setAttribute('aria-pressed', String(idx === i));
      });
      updateTimer();
    };

    const updateStage = () => {
      const dragOffset = dragActive ? Math.max(-120, Math.min(120, dragDx)) : 0;
      if (stage) stage.style.transform = dragOffset ? `translateX(${dragOffset * 0.3}px)` : 'none';
    };

    // Hovering keeps autoplay running; pause only while dragging the image.
    const updateTimer = () => {
      if (timer !== undefined) {
        clearTimeout(timer);
        timer = undefined;
      }
      if (!dragActive) {
        // Restart the visible fill and the timer together, including manual selection.
        const fill = bars[idx]?.querySelector('.hss-prog-fill');
        if (fill) fill.replaceWith(fill.cloneNode(true));
        timer = window.setTimeout(() => go(idx + 1), DURATION);
      }
    };

    const endDrag = () => {
      if (!dragActive) return;
      if (Math.abs(dragDx) > SWIPE_THRESHOLD) go(dragDx < 0 ? idx + 1 : idx - 1);
      dragActive = false;
      dragStartX = 0;
      dragDx = 0;
      section.classList.remove('is-dragging');
      updateStage();
      updateTimer();
    };

    section.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      if ((e.target as HTMLElement).closest('button')) return;
      dragActive = true;
      dragStartX = e.clientX;
      dragDx = 0;
      section.classList.add('is-dragging');
      updateStage();
      updateTimer();
      try {
        section.setPointerCapture(e.pointerId);
      } catch {
        /* noop */
      }
    });
    section.addEventListener('pointermove', (e) => {
      if (!dragActive) return;
      dragDx = e.clientX - dragStartX;
      updateStage();
    });
    section.addEventListener('pointerup', endDrag);
    section.addEventListener('pointercancel', endDrag);
    section.addEventListener('mouseleave', endDrag);
    bars.forEach((bar, i) => bar.addEventListener('click', () => go(i)));

    updateTimer();
  }

  // ── Animated counters (homepage.tsx AnimatedCounter) ──
  function initCounters(): void {
    document.querySelectorAll<HTMLElement>('span[data-target]').forEach((el) => {
      const target = Number(el.dataset.target || '0');
      const suffix = el.dataset.suffix || '';
      const duration = Number(el.dataset.duration || '1800');
      // React rendered 0 until the counter intersected; static HTML carries the
      // final number for no-JS/SEO, then JS resets and counts up identically.
      el.textContent = (0).toLocaleString() + suffix;
      let started = false;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || started) return;
            started = true;
            io.disconnect();
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / duration);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = Math.floor(target * eased).toLocaleString() + suffix;
              if (t < 1) requestAnimationFrame(tick);
              else el.textContent = target.toLocaleString() + suffix;
            };
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.4 }
      );
      io.observe(el);
    });
  }

  // ── Course category filter (homepage.tsx Courses) ──
  function initCourseFilter(): void {
    const grid = document.querySelector<HTMLElement>('#courses .course-grid');
    if (!grid) return;
    const desktopLimit = Number(grid.dataset.limit);
    const mobileLimit = Number(grid.dataset.mobileLimit);
    const mobileViewport = window.matchMedia('(max-width: 700px)');
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#courses .course-filters .chip'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-cat]'));
    const showCategory = (cat: string, animate: boolean): void => {
      const limit = mobileViewport.matches ? mobileLimit : desktopLimit;
      const shown = cards.filter((card) => cat === 'ทั้งหมด' || card.dataset.cat === cat).slice(0, limit);
      const visibleCards = new Set(shown);
      cards.forEach((card) => {
        card.classList.remove('mobile-course-overflow');
        card.hidden = !visibleCards.has(card);
      });
      if (animate) {
        shown.forEach((card, i) => {
          card.classList.add('in');
          card.style.setProperty('--reveal-delay', `${Math.min(i * 0.04, 0.4)}s`);
        });
      }
    };
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.cat || 'ทั้งหมด';
        chips.forEach((c) => {
          c.classList.toggle('chip-active', c === chip);
          c.setAttribute('aria-pressed', String(c === chip));
        });
        showCategory(cat, true);
      });
    });
    mobileViewport.addEventListener('change', () => {
      const activeCategory = chips.find((chip) => chip.classList.contains('chip-active'))?.dataset.cat || 'ทั้งหมด';
      showCategory(activeCategory, false);
    });
  }

  // ── Testimonials carousel (homepage-sections.jsx Testimonials) ──
  // Autoplay every 6s, plus pointer drag/swipe: the track follows the pointer
  // (clamped to ±60% of the carousel width), a release past SWIPE_THRESHOLD
  // advances, and the autoplay interval is suspended while dragging and
  // restarted afterwards — the design re-creates its interval when
  // `drag.active` flips back to false, so the 6s count starts over.
  function initTestimonials(): void {
    const carousel = document.querySelector<HTMLElement>('.testi-carousel');
    const track = document.querySelector<HTMLElement>('.testi-track');
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.testi-dot'));
    if (!carousel || !track || dots.length === 0) return;
    const N = dots.length;
    const SWIPE_THRESHOLD = 60;
    let idx = 0;
    let dragActive = false;
    let dragStartX = 0;
    let dragDx = 0;
    let timer: number | null = null;

    const render = () => {
      const w = carousel.offsetWidth || 1;
      const dragPct = dragActive ? Math.max(-60, Math.min(60, (dragDx / w) * 100)) : 0;
      track.style.transform = `translateX(${-idx * 100 + dragPct}%)`;
      track.style.transition = dragActive ? 'none' : '';
      dots.forEach((d, i) => d.classList.toggle('on', idx === i));
    };
    const go = (n: number) => {
      idx = (n + N) % N;
      render();
    };
    const startTimer = () => {
      if (timer !== null) clearInterval(timer);
      timer = window.setInterval(() => go(idx + 1), 6000);
    };
    const stopTimer = () => {
      if (timer !== null) clearInterval(timer);
      timer = null;
    };

    carousel.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      if ((e.target as HTMLElement).closest('button, a')) return;
      dragActive = true;
      dragStartX = e.clientX ?? 0;
      dragDx = 0;
      carousel.classList.add('is-dragging');
      stopTimer();
      try {
        carousel.setPointerCapture(e.pointerId);
      } catch {
        /* noop */
      }
      render();
    });
    carousel.addEventListener('pointermove', (e) => {
      if (!dragActive) return;
      dragDx = (e.clientX ?? 0) - dragStartX;
      render();
    });
    const endDrag = () => {
      if (!dragActive) return;
      const dx = dragDx;
      dragActive = false;
      dragStartX = 0;
      dragDx = 0;
      carousel.classList.remove('is-dragging');
      if (Math.abs(dx) > SWIPE_THRESHOLD) go(dx < 0 ? idx + 1 : idx - 1);
      else render();
      startTimer();
    };
    carousel.addEventListener('pointerup', endDrag);
    carousel.addEventListener('pointercancel', endDrag);

    // Dot clicks do not reset the interval (design's effect only depends on drag.active).
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    startTimer();
  }

  // ── FAQ single-open accordion (homepage.tsx FAQ) ──
  function initFaq(): void {
    const items = Array.from(document.querySelectorAll<HTMLElement>('.faq-list .faq-item'));
    const PLUS_D = 'M12 5v14M5 12h14';
    const MINUS_D = 'M5 12h14';
    let open = 0;
    const render = () => {
      items.forEach((item, i) => {
        const isOpen = open === i;
        item.classList.toggle('open', isOpen);
        const path = item.querySelector('.faq-q svg path');
        if (path) path.setAttribute('d', isOpen ? MINUS_D : PLUS_D);
      });
    };
    items.forEach((item, i) => {
      item.addEventListener('click', () => {
        open = open === i ? -1 : i;
        render();
      });
    });
  }

  initSlideshow();
  initCounters();
  initCourseFilter();
  initTestimonials();
  initFaq();
</script>
