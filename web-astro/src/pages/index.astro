---

<Base keywords={DEFAULT_KEYWORDS} path="">
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/slide-1-apply.webp" fetchpriority="high" />
  </Fragment>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(FAQ_JSONLD)} />
  {/* Visually-hidden H1 for SEO crawlers; visible headings rendered by the slideshow hero. */}
  <h1 style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
    วิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง — เปิดรับสมัครนักศึกษาใหม่ ปวช. ปวส. ป.ตรี ปีการศึกษา 2569
  </h1>

  <main>
    {/* ── Hero Slideshow ── */}
    <section class="hero hero-slideshow " style="touch-action:pan-y;user-select:none">
      <div class="hss-stage" style="transform:none">
        {SLIDES.map((s, i) => (
          <div class={`hss-slide ${i === 0 ? 'on' : ''} ${i === 1 ? 'next' : ''}`} aria-hidden={i !== 0 ? 'true' : 'false'}>
            <div class="hss-bg">
              <img src={s.img} alt="" class="hss-img" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} draggable="false" />
              <div class="hss-tint" style={`background:${s.tint}`}></div>
              <div class="hss-vignette"></div>
            </div>
          </div>
        ))}
      </div>
      <div class="container hss-inner">
        <div class="hss-content">
          {SLIDES.map((s, i) => (
            <div class={`hss-copy ${i === 0 ? 'on' : ''}`} aria-hidden={i !== 0 ? 'true' : 'false'}>
              <div class="hero-eyebrow hss-eyebrow"><span class="hero-eyebrow-dot"></span>{s.eyebrow}</div>
              <h1 class="hero-title hss-title">{s.title}</h1>
              <p class="hero-sub hss-sub">{s.sub}</p>
              <div class="hero-cta hss-cta">
                <a href={s.cta.href} class="btn btn-white btn-lg">{s.cta.label}<Icon name="arrow" className="btn-icon" /></a>
              </div>
            </div>
          ))}
        </div>
        <div class="hss-controls">
          <button class="hss-nav" aria-label="สไลด์ก่อนหน้า">
            <Icon name="chevronRight" style={{ width: 22, height: 22, transform: 'rotate(180deg)' }} />
          </button>
          <div class="hss-progress" role="tablist">
            {SLIDES.map((_s, i) => (
              <button class={`hss-prog-bar ${i === 0 ? 'on' : ''} `} aria-label={`ไปสไลด์ ${i + 1}`} role="tab">
                <span class="hss-prog-fill"></span>
              </button>
            ))}
          </div>
          <button class="hss-nav" aria-label="สไลด์ถัดไป">
            <Icon name="chevronRight" style={{ width: 22, height: 22 }} />
          </button>
        </div>
      </div>
      <div class="hss-counter">
        <strong>01</strong>
        <span>/</span>
        <em>{String(SLIDES.length).padStart(2, '0')}</em>
      </div>
    </section>

    {/* ── Trust band (accreditation + awards) ── */}
    <section class="trust-band" aria-label="การรับรองและรางวัล">
      <div class="container">
        <div class="trust-grid">
          {TRUST_ITEMS.map((it, i) => (
            <div class={`reveal  trust-item`} style={`--reveal-delay:${i * 0.06}s`}>
              <span class="trust-ic"><Icon name={it.icon} style={{ width: 22, height: 22 }} /></span>
              <span class="trust-tx">
                <strong>{it.t}</strong>
                <span>{it.d}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Highlights / News strip ── */}
    <section class="section section-sm highlights-section" id="highlights">
      <div class="container">
        <div class="reveal  highlights-head" style="--reveal-delay:0s">
          <span class="eyebrow">ข่าวสารล่าสุด</span>
          <a href="/news/" class="highlights-all">ดูทั้งหมด <Icon name="arrow" style={{ width: 16, height: 16 }} /></a>
        </div>
        <div class="highlights-grid">
          {HIGHLIGHT_NEWS.map((n, i) => (
            <div class="reveal  " style={`--reveal-delay:${i * 0.08}s`}>
              <a href={`/news/${n.slug}/`} class="hl-card">
                <div class="hl-img hl-img-photo">
                  <img src={n.image} alt={n.title} loading="lazy" style={`object-position:${n.objectPosition}`} />
                </div>
                <div class="hl-body">
                  <span class="hl-tag" style="font-size:16px">{n.tag}</span>
                  <h3 class="hl-t">{n.title}</h3>
                  <p class="hl-d">{n.excerpt}</p>
                  <span class="hl-arrow">อ่านต่อ <Icon name="arrow" style={{ width: 14, height: 14 }} /></span>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Stats bar ── */}
    <section class="stats-bar">
      <div class="container">
        <div class="stats-grid">
          {STATS.map((s, i) => (
            <div class="reveal  stat-item" style={`--reveal-delay:${i * 0.06}s`}>
              <div class="stat-v"><span data-target={String(s.v)} data-suffix={s.s} data-duration={String(1500 + i * 100)}>{s.v.toLocaleString()}{s.s}</span></div>
              <div class="stat-l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Courses (lift cards) ── */}
    <section class="section" id="courses">
      <div class="container">
        <div class="reveal  section-head" style="--reveal-delay:0s">
          <span class="eyebrow">หลักสูตรของเรา</span>
          <h2 class="section-title">
            18 สาขาวิชา <span class="grad">ครอบคลุมทุกสายอาชีพ</span>
          </h2>
          <p class="section-sub">เรียนกับอาจารย์ที่มีประสบการณ์จริงในอุตสาหกรรม พร้อมห้องปฏิบัติการมาตรฐาน และเครื่องมือทันสมัย</p>
        </div>
        <div class="reveal  course-filters" style="--reveal-delay:0.1s">
          {CATS.map((c, i) => (
