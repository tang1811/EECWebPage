const TESTIMONIALS = [
  { name: 'นางสาว บงกช สินฉาย', dept: 'สาขา การจัดการโลจิสติกส์', text: 'เรียนที่นี่เหมือนเรียนกับครอบครัวค่ะ ทุกคนเพื่อนและอาจารย์ทุกท่านให้ความเป็นกันเอง สงสัยอะไรเมื่อไหร่ให้คำตอบได้เสมอ', avatar: 'บ', color: '#0f7a3e' },
