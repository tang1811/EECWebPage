---
import Base from '../../layouts/Base.astro';
import '../../styles/homepage.css';
import '../../styles/subpages.css';
import { Icon } from '../../components/react/chrome-lite';
import { COURSES as COURSE_DATA } from '../../data/course-data';
import { SITE_URL } from '../../config';

// Use the same course records for cards, filters and structured data.
const levels = ['ทั้งหมด', 'ปวช.', 'ปวส.', 'ป.ตรี'];
const cats = ['ทั้งหมด', 'อุตสาหกรรม', 'ดิจิทัล', 'บริหาร'];

// ── JSON-LD (verbatim from web/app/courses/page.tsx) ────────
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'หลักสูตรทั้งหมด · วิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง',
  numberOfItems: COURSE_DATA.length,
  itemListElement: COURSE_DATA.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${c.code} ${c.name}`,
    url: `${SITE_URL}/courses/${c.slug}`,
  })),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'หลักสูตร', item: `${SITE_URL}/courses` },
  ],
};
---

<Base
  title={`หลักสูตร ${COURSE_DATA.length} หลักสูตร · ปวช. ปวส. ป.ตรี`}
  description={`หลักสูตร ปวช. ปวส. และ ป.ตรี ${COURSE_DATA.length} หลักสูตร ครอบคลุมช่างยนต์ ไฟฟ้า เมคคาทรอนิกส์ โลจิสติกส์ ดิจิทัล และบริหาร ที่แหลมฉบัง ศรีราชา ชลบุรี`}
  path="/courses"
  keywords={[
    'หลักสูตร ปวช',
    'หลักสูตร ปวส',
    'ปริญญาตรี อาชีวศึกษา',
    'สาขาช่างยนต์',
    'สาขาไฟฟ้า',
    'เมคคาทรอนิกส์',
    'โลจิสติกส์',
  ]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <main>
    <section class="section courses-catalog" id="courses">
      <div class="container">
        <div class="reveal section-head" style="--reveal-delay:0s">
          <span class="eyebrow">หลักสูตรของเรา</span>
          <h1 class="section-title">{COURSE_DATA.length} หลักสูตร <span class="grad">ค้นหาสาขาที่เหมาะกับคุณ</span></h1>
          <p class="section-sub">เรียนกับอาจารย์ที่มีประสบการณ์จริงในอุตสาหกรรม พร้อมห้องปฏิบัติการมาตรฐาน และเครื่องมือทันสมัย</p>
        </div>
        <div class="courses-toolbar">
          <div class="tabs" role="group" aria-label="ระดับการศึกษา">
            {levels.map((l, i) => (
              <button type="button" class:list={['tab', { on: i === 0 }]} data-level={l} aria-pressed={i === 0}>{l}</button>
            ))}
          </div>
          <div class="courses-count" role="status">
            แสดง <strong data-shown-count>{COURSE_DATA.length}</strong> หลักสูตร
          </div>
        </div>
        <div class="courses-filters-row">
          <div class="course-filters" role="group" aria-label="หมวดสาขาวิชา">
            {cats.map((c, i) => (
              <button type="button" class:list={['chip', { 'chip-active': i === 0 }]} data-cat={c} aria-pressed={i === 0}>{c}</button>
            ))}
          </div>
          <label class="course-dual-filter">
            <input type="checkbox" data-dual-filter />
            <span>เฉพาะทวิภาคี</span>
          </label>
        </div>
        <div class="course-grid card-lift">
          {COURSE_DATA.map((c, i) => (
            <div class="reveal reveal-scale" style={`--reveal-delay:${Math.min(i * 0.04, 0.4)}s`} data-cat={c.cat} data-code={c.code} data-dual={c.dualVocational ? 'true' : 'false'}>
              <a href={`/courses/${c.slug}/`} class="course-card cc-lift" style={c.color ? `--dept:${c.color}` : undefined}>
                {c.img && (
                  <div class="cc-photo">
                    <img src={c.img} alt="" loading="lazy" />
                    {c.hot && <span class="cc-hot">HOT</span>}
                    {c.color && <div class="cc-color-bar" style={`background:${c.color}`}></div>}
                  </div>
                )}
                {!c.img && <div class="cc-icon"><Icon name={c.icon} style={{ width: 28, height: 28 }} /></div>}
                <div class="cc-body">
                  <div class="course-card-meta">
                    <span class="cc-code">{c.code} · {c.cat}</span>
                    {c.dualVocational && <span class="course-dual-badge"><Icon name="check" style={{ width: 13, height: 13 }} /> ทวิภาคี</span>}
                  </div>
                  <h3 class="cc-name">{c.name}</h3>
                  <div class="cc-foot">
                    <span style="font-size:16px">ดูรายละเอียด</span>
                    <Icon name="arrow" style={{ width: 18, height: 18 }} />
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
        <p class="courses-empty" hidden>ไม่พบหลักสูตรตามตัวกรองที่เลือก ลองเปลี่ยนตัวกรองเพื่อดูหลักสูตรอื่น</p>
      </div>
    </section>

    <section class="section cta-section">
      <div class="container">
        <div class="reveal reveal-scale cta-banner" style="--reveal-delay:0s">
          <div class="cta-bg-mesh"></div>
          <div class="cta-content">
            <span class="eyebrow" style="background:rgba(255,255,255,0.18);color:white">วางแผนเรียนต่อ</span>
            <h2 class="cta-title">พร้อมเริ่มต้นเส้นทาง<br /><span class="grad-light">อาชีพที่ใช่</span>หรือยัง?</h2>
            <p class="cta-sub">สอบถามคุณสมบัติ วันเรียน ค่าใช้จ่าย และรอบรับสมัครกับวิทยาลัย</p>
            <div class="cta-actions">
              <a href="/contact/" class="btn btn-white btn-lg">สอบถามการสมัครเรียน<Icon name="arrow" className="btn-icon" /></a>
              <a href="tel:038494066" class="btn btn-ghost btn-lg" style="color:white;border-color:rgba(255,255,255,0.4)"><Icon name="phone" style={{ width: 16, height: 16 }} /> 038-494-066</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .courses-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; }
  .courses-count { color: var(--ink-500); font-size: 14px; }
  .courses-count strong { color: var(--ink-900); }
  .courses-filters-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 40px; }
  .courses-filters-row .course-filters { margin-bottom: 0; }
  .course-dual-filter { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 10px 16px; border: 1px solid var(--border-strong); border-radius: var(--r-pill); color: var(--green-800); background: var(--surface-card); font-size: 14px; font-weight: 600; cursor: pointer; }
  .course-dual-filter input { width: 18px; height: 18px; flex-shrink: 0; margin: 0; accent-color: var(--green-700); cursor: pointer; }
  .course-dual-filter:has(:checked) { background: var(--green-100); border-color: var(--green-700); }
  .course-dual-filter:has(:focus-visible) { outline: 3px solid var(--accent-amber); outline-offset: 3px; }
  .course-card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .course-dual-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: var(--r-pill); color: var(--green-800); background: var(--green-100); font-size: 12px; font-weight: 600; white-space: nowrap; }
  .courses-empty { padding: 32px 20px; margin: 0; text-align: center; color: var(--ink-600); background: var(--bg-alt); border-radius: var(--r-md); }
  .courses-catalog .tab:focus-visible, .courses-catalog .chip:focus-visible { outline: 3px solid var(--accent-amber); outline-offset: 3px; }
  @media (max-width: 700px) {
    .courses-toolbar .tabs { width: 100%; }
    .courses-toolbar .tab { flex: 1; min-width: 0; padding: 10px 8px; }
  }
</style>

<script>
  const catalog = document.querySelector<HTMLElement>('.courses-catalog');
  if (catalog) {
    const tabs = Array.from(catalog.querySelectorAll<HTMLButtonElement>('[data-level]'));
    const chips = Array.from(catalog.querySelectorAll<HTMLButtonElement>('.course-filters .chip'));
    const dualFilter = catalog.querySelector<HTMLInputElement>('[data-dual-filter]');
    const grid = catalog.querySelector<HTMLElement>('.course-grid');
    const cards = grid ? Array.from(grid.children) as HTMLElement[] : [];
    const countEl = catalog.querySelector<HTMLElement>('[data-shown-count]');
    const emptyEl = catalog.querySelector<HTMLElement>('.courses-empty');
    let level = 'ทั้งหมด';
    let category = 'ทั้งหมด';

    const renderCourses = () => {
      if (!grid) return;
      const shown = cards.filter((card) =>
        (level === 'ทั้งหมด' || card.dataset.code === level) &&
        (category === 'ทั้งหมด' || card.dataset.cat === category) &&
        (!dualFilter?.checked || card.dataset.dual === 'true')
      );
      // Reattached cards must remain visible even if already observed by the reveal animation.
      shown.forEach((card, i) => {
        card.classList.add('in');
        card.style.setProperty('--reveal-delay', `${Math.min(i * 0.04, 0.4)}s`);
      });
      grid.replaceChildren(...shown);
      if (countEl) countEl.textContent = String(shown.length);
      if (emptyEl) emptyEl.hidden = shown.length > 0;
      tabs.forEach((tab) => {
        const active = tab.dataset.level === level;
        tab.classList.toggle('on', active);
        tab.setAttribute('aria-pressed', String(active));
      });
      chips.forEach((chip) => {
        const active = chip.dataset.cat === category;
        chip.classList.toggle('chip-active', active);
        chip.setAttribute('aria-pressed', String(active));
      });
    };
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      level = tab.dataset.level || 'ทั้งหมด';
      renderCourses();
    }));
    chips.forEach((chip) => chip.addEventListener('click', () => {
      category = chip.dataset.cat || 'ทั้งหมด';
      renderCourses();
    }));
    dualFilter?.addEventListener('change', renderCourses);
  }
</script>
