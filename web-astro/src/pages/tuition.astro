---
import Base from '../layouts/Base.astro';
import '../styles/homepage.css';
import '../styles/subpages.css';
import '../styles/tuition.css';
import { ONLINE_ADMISSION_ENABLED } from '../config';

type TuitionGroup = 'บริหารธุรกิจ' | 'ช่างอุตสาหกรรม';
type Row = { group: TuitionGroup; level: string; sub: string; perTerm: string; installment: string; perYear: string };

// อัตราค่าเล่าเรียน ปีการศึกษา 2569 (จากประกาศวิทยาลัย) — ต่อภาคเรียน
const TUITION_ROWS: Row[] = [
  { group: 'บริหารธุรกิจ', level: 'ปวช.', sub: 'รอบเช้า', perTerm: '17,000', installment: '3,400 × 5 งวด', perYear: '34,000' },
  { group: 'บริหารธุรกิจ', level: 'ปวช.', sub: 'รอบบ่าย', perTerm: '10,300', installment: '2,060 × 5 งวด', perYear: '20,600' },
  { group: 'ช่างอุตสาหกรรม', level: 'ปวช.', sub: 'รอบเช้า', perTerm: '19,000', installment: '3,800 × 5 งวด', perYear: '38,000' },
  { group: 'ช่างอุตสาหกรรม', level: 'ปวช.', sub: 'รอบบ่าย', perTerm: '12,300', installment: '2,460 × 5 งวด', perYear: '24,600' },
  { group: 'ช่างอุตสาหกรรม', level: 'ปวช. (อายุเกิน 25 ปี)', sub: 'รอบบ่าย', perTerm: '19,000', installment: '3,800 × 5 งวด', perYear: '38,000' },
  { group: 'บริหารธุรกิจ', level: 'ปวส.', sub: 'รอบเช้า', perTerm: '21,000', installment: '4,200 × 5 งวด', perYear: '42,000' },
  { group: 'บริหารธุรกิจ', level: 'ปวส.', sub: 'รอบบ่าย', perTerm: '18,300', installment: '3,660 × 5 งวด', perYear: '36,600' },
  { group: 'ช่างอุตสาหกรรม', level: 'ปวส.', sub: 'รอบเช้า', perTerm: '26,000', installment: '5,200 × 5 งวด', perYear: '52,000' },
  { group: 'ช่างอุตสาหกรรม', level: 'ปวส.', sub: 'รอบบ่าย', perTerm: '20,300', installment: '4,060 × 5 งวด', perYear: '40,600' },
];
const TUITION_GROUPS: TuitionGroup[] = ['บริหารธุรกิจ', 'ช่างอุตสาหกรรม'];
const applyHref = ONLINE_ADMISSION_ENABLED ? '/admission/' : '/contact/';

const AID = [
  {
    title: 'กองทุน กยศ.',
    desc: 'กู้ยืมเพื่อการศึกษา ครอบคลุมค่าเล่าเรียน + ค่าครองชีพ เริ่มผ่อนคืนหลังจบ',
  },
  {
    title: 'ทุนเรียนดี / ทุนความสามารถ',
    desc: 'ทุนสำหรับนักศึกษาผลการเรียนเด่น และทุนกีฬา/ทักษะวิชาชีพ',
  },
  {
    title: 'เรียนฟรี 15 ปี',
    desc: 'สิทธิรัฐสนับสนุนค่าเล่าเรียนระดับ ปวช. ตามนโยบายเรียนฟรี',
  },
  {
    title: 'ผ่อนชำระรายงวด',
    desc: 'แบ่งจ่ายค่าเทอมเป็นงวดได้ ลดภาระผู้ปกครองช่วงเปิดเทอม',
  },
];

const STEPS = [
  'เลือกสาขาและระดับที่ต้องการสมัคร',
  'ยื่นสมัครออนไลน์หรือที่วิทยาลัย พร้อมเอกสาร',
  'ตรวจสอบสิทธิทุน / กยศ. / ผ่อนชำระ กับฝ่ายการเงิน',
  'ชำระค่าลงทะเบียนตามงวดที่เลือก',
];

// Original fee-announcement images with click-to-zoom lightbox.
const SHOTS = [
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_1.jpg', label: 'ปวช. บริหารธุรกิจ · รอบเช้า' },
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_4.jpg', label: 'ปวช. บริหารธุรกิจ · รอบบ่าย' },
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_6.jpg', label: 'ปวช. ช่างอุตสาหกรรม · รอบเช้า' },
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_9.jpg', label: 'ปวช. ช่างอุตสาหกรรม · รอบบ่าย' },
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_3.jpg', label: 'ปวช. อายุเกิน 25 ปี · รอบบ่าย' },
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_5.jpg', label: 'ปวส. บริหารธุรกิจ · รอบเช้า' },
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_2.jpg', label: 'ปวส. บริหารธุรกิจ · รอบบ่าย' },
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_7.jpg', label: 'ปวส. ช่างอุตสาหกรรม · รอบเช้า' },
  { src: '/assets/tuition/LINE_ALBUM_61926_260619_8.jpg', label: 'ปวส. ช่างอุตสาหกรรม · รอบบ่าย' },
];
---

<Base
  title="ค่าเทอม & ทุนการศึกษา"
  description="ค่าเล่าเรียน ปวช. ปวส. และปริญญาตรี วิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง · ทุนการศึกษา กยศ. ผ่อนชำระ และสิทธิเรียนฟรี 15 ปี"
  path="/tuition"
  keywords={['ค่าเทอม อาชีวศึกษา', 'ค่าเล่าเรียน ปวช ปวส', 'ทุนการศึกษา วิทยาลัยแหลมฉบัง', 'กยศ อาชีวะ']}
>
  <main class="tuition-page">
    <section class="page-hero">
      <div class="container page-hero-inner">
        <div class="crumbs">
          <a href="/">หน้าแรก</a> <span>/</span> <span>ค่าเทอม &amp; ทุน</span>
        </div>
        <span class="eyebrow">การเงิน · ปีการศึกษา 2569</span>
        <h1>ค่าเทอม &amp; <span class="grad">ทุนการศึกษา</span></h1>
        <p>
          โปร่งใส ตรวจสอบได้ — ค่าเล่าเรียนทุกระดับ พร้อมทางเลือกทุน กยศ. ผ่อนชำระ
          และสิทธิเรียนฟรี 15 ปี เพื่อให้ทุกคนเข้าถึงการเรียนสายอาชีพได้จริง
        </p>
      </div>
    </section>

    <section class="container tu-section">
      <div class="tu-gallery">
        <h2 class="tu-h2">ประกาศค่าเทอม (ต้นฉบับ)</h2>
        <p class="tu-gallery-sub">คลิกที่รูปเพื่อดูขนาดเต็ม</p>
        <div class="tu-gallery-grid">
          {SHOTS.map((s, i) => (
            <button type="button" class="tu-gallery-item" aria-label={`ดูประกาศค่าเทอม ${s.label}`}>
              <img src={s.src} alt={`ประกาศค่าเทอม ${s.label}`} loading={i === 0 ? 'eager' : 'lazy'} />
              <span class="tu-gallery-cap">{s.label}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="contentcard tu-table-card">
        <h2>อัตราค่าเล่าเรียน ปีการศึกษา 2569</h2>
        <div class="tu-table-groups">
          {TUITION_GROUPS.map((group) => (
            <section class="tu-table-group" aria-label={`ค่าเทอมหมวด${group}`}>
              <h3>{group}</h3>
              <div class="tu-table-wrap">
                <table class="tu-table">
                  <thead>
                    <tr>
                      <th scope="col">หลักสูตร</th>
                      <th scope="col">ค่าเทอม / ภาคเรียน</th>
                      <th scope="col">ผ่อนชำระ</th>
                      <th scope="col">ต่อปี (2 ภาคเรียน)</th>
                      <th scope="col">สมัครเรียน</th>
                    </tr>
                  </thead>
                  <tbody>
                    {TUITION_ROWS.filter((r) => r.group === group).map((r) => (
                      <tr>
                        <td>
                          <strong>{r.level}</strong>
                          <span class="tu-sub">{r.sub}</span>
                        </td>
                        <td class="tu-num">{r.perTerm} ฿</td>
                        <td class="tu-note">{r.installment}</td>
                        <td class="tu-num">{r.perYear} ฿</td>
                        <td><a class="tu-apply" href={applyHref} aria-label={`สมัครเรียน ${r.level} ${group} ${r.sub}`}>สมัครเรียน</a></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="tu-mobile-cards">
                {TUITION_ROWS.filter((r) => r.group === group).map((r) => (
                  <article class="tu-fee-card">
                    <div class="tu-fee-card-head">
                      <strong>{r.level}</strong>
                      <span>{r.sub}</span>
                    </div>
                    <dl>
                      <div class="tu-fee-card-primary">
                        <dt>ค่าเทอม / ภาคเรียน</dt>
                        <dd>{r.perTerm} ฿</dd>
                      </div>
                      <div>
                        <dt>ผ่อนชำระ</dt>
                        <dd>{r.installment}</dd>
                      </div>
                      <div>
                        <dt>ต่อปี (2 ภาคเรียน)</dt>
                        <dd>{r.perYear} ฿</dd>
                      </div>
                    </dl>
                    <a class="tu-apply" href={applyHref} aria-label={`สมัครเรียน ${r.level} ${group} ${r.sub}`}>สมัครเรียน</a>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
        <p class="tu-fine">
          * ชำระค่าเทอมเต็มจำนวน หรือชำระงวดแรกในวันสมัคร · ผ่อนชำระไม่เกินวันที่ 15 ของทุกเดือน · ผ่อนได้ · กู้ กยศ. ได้ — สอบถามฝ่ายการเงิน 038-494-066
        </p>
        {!ONLINE_ADMISSION_ENABLED && <p class="tu-apply-note">ขณะนี้สมัครเรียนผ่านเจ้าหน้าที่วิทยาลัยได้จากปุ่มสมัครเรียนในตาราง</p>}
      </div>

      <h2 class="tu-h2">ทุน &amp; ทางเลือกชำระเงิน</h2>
      <div class="tu-aid-grid">
        {AID.map((a) => (
          <div class="contentcard tu-aid">
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>

      <h2 class="tu-h2">ขั้นตอนสมัคร &amp; ชำระเงิน</h2>
      <ol class="tu-steps">
        {STEPS.map((s, i) => (
          <li>
            <span class="tu-step-n">{i + 1}</span>
            <span>{s}</span>
          </li>
        ))}
      </ol>

      <div class="tu-cta">
        <div>
          <h3>พร้อมเริ่มเรียนสายอาชีพแล้ว?</h3>
          <p>สมัครออนไลน์ใช้เวลาไม่กี่นาที ทีมงานพร้อมช่วยเรื่องทุนและการผ่อนชำระ</p>
        </div>
        <div class="tu-cta-actions">
          <a href={applyHref} class="btn-primary">{ONLINE_ADMISSION_ENABLED ? 'สมัครเรียนออนไลน์' : 'ติดต่อสมัครเรียน'}</a>
          <a href="tel:038494066" class="btn-ghost">โทรถามฝ่ายการเงิน</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // Vanilla port of TuitionGallery.tsx lightbox: overlay is created on open and
  // removed on close (matching React's conditional render), appended inside .tu-gallery.
  const gallery = document.querySelector<HTMLElement>('.tu-gallery');
  if (gallery) {
    const items = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.tu-gallery-item'));
    const shots = items.map((btn) => ({
      src: btn.querySelector('img')?.getAttribute('src') ?? '',
      label: btn.querySelector('.tu-gallery-cap')?.textContent ?? '',
    }));

    let active: number | null = null;
    let overlay: HTMLDivElement | null = null;
    let lbImg: HTMLImageElement | null = null;
    let lbCaption: HTMLElement | null = null;

    const render = () => {
      if (active === null || !lbImg || !lbCaption) return;
      const s = shots[active];
      lbImg.src = s.src;
      lbImg.alt = s.label;
      lbCaption.textContent = `${s.label} · ${active + 1} / ${shots.length}`;
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') step(1);
      else if (e.key === 'ArrowLeft') step(-1);
    };

    const close = () => {
      if (!overlay) return;
      overlay.remove();
      overlay = null;
      lbImg = null;
      lbCaption = null;
      active = null;
      window.removeEventListener('keydown', onKey);
      document.body.style.overflow = '';
    };

    const step = (d: number) => {
      if (active === null) return;
      active = (active + d + shots.length) % shots.length;
      render();
    };

    const open = (i: number) => {
      active = i;
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.className = 'tu-lightbox';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-modal', 'true');
        overlay.setAttribute('aria-label', 'ประกาศค่าเทอมขนาดเต็ม');
        overlay.addEventListener('click', close);

        const closeBtn = document.createElement('button');
        closeBtn.className = 'tu-lb-close';
        closeBtn.setAttribute('aria-label', 'ปิด');
        closeBtn.textContent = '✕';
        closeBtn.addEventListener('click', close);

        const prevBtn = document.createElement('button');
        prevBtn.className = 'tu-lb-nav tu-lb-prev';
        prevBtn.setAttribute('aria-label', 'รูปก่อนหน้า');
        prevBtn.textContent = '‹';
        prevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          step(-1);
        });

        const stage = document.createElement('figure');
        stage.className = 'tu-lb-stage';
        stage.addEventListener('click', (e) => e.stopPropagation());
        lbImg = document.createElement('img');
        lbCaption = document.createElement('figcaption');
        stage.appendChild(lbImg);
        stage.appendChild(lbCaption);

        const nextBtn = document.createElement('button');
        nextBtn.className = 'tu-lb-nav tu-lb-next';
        nextBtn.setAttribute('aria-label', 'รูปถัดไป');
        nextBtn.textContent = '›';
        nextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          step(1);
        });

        overlay.appendChild(closeBtn);
        overlay.appendChild(prevBtn);
        overlay.appendChild(stage);
        overlay.appendChild(nextBtn);
        gallery.appendChild(overlay);

        window.addEventListener('keydown', onKey);
        document.body.style.overflow = 'hidden';
      }
      render();
    };

    items.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
  }
</script>
