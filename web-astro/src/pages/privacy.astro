---
// /privacy/ — PDPA policy page (SchoolWebV2 design privacy.html port).
// Content is a draft template; the notice bar asks the college's legal
// reviewer to vet it before real publication (kept from the design).
import Base from '../layouts/Base.astro';
import '../styles/subpages.css';
import '../styles/privacy.css';

const DESCRIPTION =
  'นโยบายคุ้มครองข้อมูลส่วนบุคคลของวิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง ตาม พ.ร.บ. คุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562';

const CHECK =
  '<path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>';

const SECTIONS: { title: string; items: string[] }[] = [
  {
    title: '1. ข้อมูลส่วนบุคคลที่วิทยาลัยเก็บรวบรวม',
    items: [
      'ข้อมูลระบุตัวตน: ชื่อ-นามสกุล วัน/เดือน/ปีเกิด เลขประจำตัวประชาชน (เฉพาะขั้นตอนรายงานตัวและทำสัญญา) และรูปถ่าย',
      'ข้อมูลติดต่อ: หมายเลขโทรศัพท์ อีเมล ที่อยู่ และช่องทางโซเชียลมีเดียที่ผู้สมัครแจ้งไว้',
      'ข้อมูลการศึกษา: สถานศึกษาเดิม ระดับชั้น ผลการเรียน (GPA) และสาขาวิชาที่สนใจ',
      'ข้อมูลผู้ปกครอง: ชื่อ-นามสกุล ความสัมพันธ์ และหมายเลขโทรศัพท์สำหรับติดต่อกรณีฉุกเฉิน',
      'ข้อมูลการใช้งานเว็บไซต์: หน้าที่เข้าชม เวลาที่เข้าชม และข้อมูลจากคุกกี้ที่จำเป็นต่อการทำงานของเว็บไซต์',
    ],
  },
  {
    title: '2. วัตถุประสงค์ในการใช้ข้อมูล',
    items: [
      'ดำเนินการรับสมัคร คัดเลือก และรายงานตัวเข้าศึกษา',
      'ติดต่อกลับเพื่อให้ข้อมูลหลักสูตร ค่าเล่าเรียน และทุนการศึกษา',
      'จัดทำทะเบียนนักศึกษา บันทึกผลการเรียน และออกเอกสารทางการศึกษา',
      'ดำเนินการเกี่ยวกับกองทุนเงินให้กู้ยืมเพื่อการศึกษา (กยศ.) และทุนของวิทยาลัย',
      'ประชาสัมพันธ์ข่าวสารและกิจกรรมของวิทยาลัย (ผู้รับข้อมูลสามารถขอยกเลิกได้ทุกเมื่อ)',
      'ปฏิบัติตามกฎหมายและรายงานต่อหน่วยงานต้นสังกัด เช่น สำนักงานคณะกรรมการการอาชีวศึกษา',
    ],
  },
  {
    title: '3. ฐานทางกฎหมายในการประมวลผล',
    items: [
      'ความยินยอม (Consent): กรณีการส่งใบสมัครออนไลน์ การรับข่าวสาร และการเผยแพร่ภาพกิจกรรม',
      'สัญญา (Contract): การดำเนินการตามสัญญาการศึกษาและการชำระค่าเล่าเรียน',
      'หน้าที่ตามกฎหมาย (Legal obligation): การจัดทำทะเบียนและรายงานต่อหน่วยงานรัฐ',
      'ประโยชน์โดยชอบด้วยกฎหมาย (Legitimate interest): การรักษาความปลอดภัยในสถานศึกษา',
    ],
  },
  {
    title: '4. การเปิดเผยข้อมูลแก่บุคคลภายนอก',
    items: [
      'วิทยาลัยไม่ขายหรือให้เช่าข้อมูลส่วนบุคคลแก่บุคคลภายนอกเพื่อวัตถุประสงค์ทางการตลาด',
      'อาจเปิดเผยข้อมูลเท่าที่จำเป็นแก่หน่วยงานต้นสังกัดและหน่วยงานราชการที่เกี่ยวข้อง',
      'กองทุน กยศ. และสถาบันการเงินคู่สัญญา',
      'สถานประกอบการที่รับนักศึกษาฝึกอาชีพระบบทวิภาคี',
      'ผู้ให้บริการระบบสารสนเทศที่ทำสัญญารักษาความลับกับวิทยาลัย',
    ],
  },
  {
    title: '5. ระยะเวลาการเก็บรักษาข้อมูล',
    items: [
      'ข้อมูลผู้สมัครที่ไม่ได้เข้าศึกษา: เก็บไม่เกิน 1 ปีการศึกษา แล้วลบหรือทำให้ไม่สามารถระบุตัวบุคคลได้',
      'ข้อมูลนักศึกษาปัจจุบันและศิษย์เก่า: เก็บตลอดระยะเวลาการศึกษาและต่อเนื่องตามที่กฎหมายกำหนดสำหรับเอกสารทางการศึกษา',
      'ข้อมูลการใช้งานเว็บไซต์: เก็บไม่เกิน 12 เดือน',
    ],
  },
  {
    title: '6. สิทธิของเจ้าของข้อมูลส่วนบุคคล',
    items: [
      'สิทธิขอเข้าถึงและขอรับสำเนาข้อมูลของตน',
      'สิทธิขอแก้ไขข้อมูลให้ถูกต้องเป็นปัจจุบัน',
      'สิทธิขอลบหรือทำลายข้อมูล เมื่อหมดความจำเป็นตามวัตถุประสงค์',
      'สิทธิขอให้ระงับการใช้ข้อมูล และสิทธิคัดค้านการประมวลผล',
      'สิทธิขอถอนความยินยอมเมื่อใดก็ได้ โดยไม่กระทบการประมวลผลที่ทำไปแล้ว',
      'สิทธิร้องเรียนต่อสำนักงานคณะกรรมการคุ้มครองข้อมูลส่วนบุคคล หากเห็นว่าวิทยาลัยไม่ปฏิบัติตามกฎหมาย',
    ],
  },
  {
    title: '7. ข้อมูลของผู้เยาว์',
    items: [
      'ผู้สมัครที่มีอายุต่ำกว่า 20 ปี ต้องได้รับความยินยอมจากบิดา มารดา หรือผู้ปกครองตามกฎหมายก่อนส่งข้อมูล',
      'วิทยาลัยอาจขอเอกสารยืนยันความยินยอมของผู้ปกครองในขั้นตอนการรายงานตัว',
    ],
  },
  {
    title: '8. คุกกี้ (Cookies)',
    items: [
      'เว็บไซต์ใช้คุกกี้ที่จำเป็นต่อการทำงานของหน้าเว็บ เช่น การจดจำการตั้งค่าการแสดงผล',
      'หากมีการใช้คุกกี้เพื่อวิเคราะห์การเข้าชม (เช่น Google Analytics) วิทยาลัยจะขอความยินยอมก่อน และผู้ใช้สามารถปิดคุกกี้ได้จากการตั้งค่าเบราว์เซอร์',
    ],
  },
  {
    title: '9. ความมั่นคงปลอดภัยของข้อมูล',
    items: [
      'วิทยาลัยจัดให้มีมาตรการรักษาความมั่นคงปลอดภัยที่เหมาะสม ทั้งด้านการเข้าถึงระบบ การกำหนดสิทธิ์ผู้ใช้งาน และการสำรองข้อมูล',
      'จำกัดการเข้าถึงข้อมูลเฉพาะบุคลากรที่มีความจำเป็นต่อการปฏิบัติหน้าที่เท่านั้น',
    ],
  },
];

const revealDelay = (i: number) => Math.min(i * 0.04, 0.24);
---

<Base
  title="นโยบายความเป็นส่วนตัว (PDPA)"
  description={DESCRIPTION}
  path="/privacy"
  keywords={['นโยบายความเป็นส่วนตัว', 'PDPA วิทยาลัย', 'คุ้มครองข้อมูลส่วนบุคคล']}
  og={{
    title: 'นโยบายความเป็นส่วนตัว (PDPA)',
    description: DESCRIPTION,
    image: '/assets/logo.png',
    type: 'article',
  }}
>
  <main class="privacy-page">
    <section class="art-top">
      <div class="container art-narrow">
        <div class="crumbs">
          <a href="/">หน้าแรก</a>
          <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
          <span>นโยบายความเป็นส่วนตัว</span>
        </div>
        <span class="art-cat">PDPA</span>
        <h1>นโยบายคุ้มครองข้อมูลส่วนบุคคล</h1>
        <div class="art-meta">
          <span><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>ปรับปรุงล่าสุด <time datetime="2026-08-06">6 สิงหาคม 2569</time></span>
          <span><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 2l9 4v6c0 5-3.5 9.5-9 10-5.5-.5-9-5-9-10V6l9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/></svg>ตาม พ.ร.บ. คุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562</span>
        </div>
      </div>
    </section>

    <section class="section section-sm">
      <div class="container art-narrow">
        <div class="reveal notice-bar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>เอกสารนี้เป็นร่างต้นแบบสำหรับเว็บไซต์ — ควรให้ผู้รับผิดชอบของวิทยาลัยหรือที่ปรึกษากฎหมายตรวจสอบก่อนเผยแพร่จริง</span>
        </div>
        <div class="reveal art-body">
          <p class="art-lead">วิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง ให้ความสำคัญกับการคุ้มครองข้อมูลส่วนบุคคลของผู้สมัคร นักศึกษา ผู้ปกครอง และผู้เข้าชมเว็บไซต์ นโยบายฉบับนี้อธิบายว่าเราเก็บข้อมูลอะไร ใช้เพื่ออะไร เก็บนานเท่าใด และท่านมีสิทธิอย่างไร</p>
        </div>
        <div class="policy-list">
          {SECTIONS.map((s, i) => (
            <div class="reveal policy-block" style={`--reveal-delay:${revealDelay(i)}s`}>
              <h2>{s.title}</h2>
              <ul>
                {s.items.map((item) => (
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={CHECK} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="reveal policy-contact">
          <h2>10. ติดต่อเจ้าหน้าที่คุ้มครองข้อมูลส่วนบุคคล</h2>
          <p>หากต้องการใช้สิทธิของเจ้าของข้อมูล หรือมีข้อสงสัยเกี่ยวกับนโยบายฉบับนี้ ติดต่อได้ที่</p>
          <dl>
            <div><dt>หน่วยงาน</dt><dd>งานธุรการ วิทยาลัยเทคโนโลยีอีอีซี เอ็นจิเนีย แหลมฉบัง</dd></div>
            <div><dt>ที่อยู่</dt><dd>75/2 หมู่ 10 ต.ทุ่งสุขลา อ.ศรีราชา จ.ชลบุรี 20230</dd></div>
            <div><dt>โทรศัพท์</dt><dd><a href="tel:038494066">038-494-066</a></dd></div>
            <div><dt>อีเมล</dt><dd><a href="mailto:technologylaemchabang@gmail.com">technologylaemchabang@gmail.com</a></dd></div>
          </dl>
          <div class="policy-actions">
            <a href="/contact/" class="btn btn-primary">ติดต่อวิทยาลัย<svg viewBox="0 0 24 24" width="16" height="16" class="btn-icon" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></a>
            <a href="/admission/" class="btn btn-ghost">กลับไปหน้าสมัครเรียน</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
